---
import '../styles/global.css';
import { getLangFromUrl, useTranslations, generateLocalePaths, generateLocaleUrls} from '../i18n/i18n';
import BottomNavigation from '../components/BottomNavigation.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const localePaths = generateLocalePaths(Astro.url);
const localeUrls = generateLocaleUrls(Astro.url);
---

<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		{
			Object.keys(localeUrls).map((props) => (
				<link rel="alternate" hreflang={localeUrls[props].locale} href={localeUrls[props].path} />
			))
		}
		<title>{t('title')}</title>
	</head>
	<body>
    <slot />
		<BottomNavigation />
	</body>
</html>

<script is:inline src="https://cdn.jsdelivr.net/npm/flowbite@3.1.2/dist/flowbite.min.js"></script>