---
import BaseLayout from '../layouts/BaseLayout.astro';
import Logo from '../components/Logo.astro';
---

<BaseLayout>
  <Logo />
  <div class="main">
    <div class="title-section">
      <h1 class="title">アクセス</h1>
    </div>

    <div class="address-section">
      <p>三段峡ホテル 南峰</p>
      <p>〒731-3813 広島県山県郡安芸太田町柴木1734</p>
    </div>

    <div class="map-container">
      <iframe
        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3284.1715475061796!2d132.20594251231256!3d34.599823372842934!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x355aed2a59c04987%3A0xc78b5e19947974a4!2z5LiJ5q615bOh44Ob44OG44Or5Y2X5bOw!5e0!3m2!1sen!2sjp!4v1788572050472!5m2!1sen!2sjp"
        width="100%"
        height="600"
        style="border:0;"
        allowfullscreen=""
        loading="lazy"
        referrerpolicy="strict-origin-when-cross-origin">
      </iframe>
    </div>

    <div class="info-group">
      <h3 class="info-group-title">車でお越しの場合</h3>
      <ul class="transport-list">
        <li>広島市内から約1時間30分。</li>
        <li>中国自動車道「戸河内IC」より約20分。</li>
        <li>駐車場は5台完備。</li>
      </ul>
    </div>

    <div class="info-group">
      <h3 class="info-group-title">公共交通機関でお越しの場合</h3>
      <ul class="transport-list">
        <li>
          広島駅新幹線口から安芸太田町役場まで高速バス（新広益線）で約80分。安芸太田町役場からホテルまでタクシーで約10分。<br/>
          <span class="note">※安芸太田町役場からの送迎はございません。予めご了承ください。</span>
        </li>
        <li>広島駅から広島バスセンター最寄り紙屋町東駅まで約10分。広島バスセンターからホテルまで高速バス（三段峡線）で約80分。</li>
      </ul>
    </div>
  </div>
</BaseLayout>

<style>
  .main {
    min-height: 100vh;
    width: 100%;
  }

  .title-section {
    max-width: 1240px;
    height: auto;
    padding: 0 20px;
    margin: 0 auto;
    display: flex;
    justify-content: center;
    gap: 20px;
  }

  .title {
    font-size: 32px;
    letter-spacing: 8px;
    font-weight: normal;
    margin-top: 200px;
  }

  .address-section {
    text-align: center;
    margin: 60px 0;
  }

  .address-section h3 {
    font-size: 18px;
    letter-spacing: 2px;
    margin-bottom: 15px;
    font-weight: normal;
  }

  .address-section p {
    font-size: 16px;
    line-height: 2;
    letter-spacing: 1px;
    margin: 5px 0;
  }

  .map-container {
    width: 100%;
    margin: 100px 0px;
  }

  .map-container iframe {
    width: 100%;
  }

  .info-group {
    max-width: 1240px;
    height: auto;
    padding: 0 20px 70px 20px;
    margin: 0 auto;
  }

  .info-group-title {
    font-size: 26px;
    letter-spacing: 2px;
    margin-bottom: 30px;
    font-weight: normal;
  }

  .info-group p {
    font-size: 16px;
    line-height: 2;
    letter-spacing: 1px;
    margin: 5px 0;
  }

  .transport-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .transport-list li {
    font-size: 16px;
    line-height: 2;
    letter-spacing: 1px;
    margin-bottom: 15px;
    padding-left: 20px;
    position: relative;
  }

  .transport-list li::before {
    content: "・";
    position: absolute;
    left: 0;
  }

  .note {
    font-size: 14px;
    display: block;
    margin-top: 5px;
    padding-left: 10px;
  }

  @media screen and (max-width: 1024px) {
    .page-content {
      padding: 100px 40px 60px 40px;
    }

    .title-ja {
      font-size: 32px;
    }

    .title-en {
      font-size: 18px;
    }

    .center-logo {
      width: 120px;
    }
  }
</style>
