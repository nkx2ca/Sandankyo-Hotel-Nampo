---
import BaseLayout from '../layouts/BaseLayout.astro';
import Logo from '../components/Logo.astro';
import AccessPage from '../components/pages/AccessPage.astro';
import { getLangFromUrl, usePageContent } from '../i18n/i18n';

const lang = getLangFromUrl(Astro.url);
const content = usePageContent(lang, 'access');
---

<BaseLayout>
  <Logo />
  <AccessPage lang={lang} content={content} />
</BaseLayout>
