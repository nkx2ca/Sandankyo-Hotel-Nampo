---
import BaseLayout from '../layouts/BaseLayout.astro';
import Logo from '../components/Logo.astro';
import AccessPage from '../components/pages/AccessPage.astro';
import { getLangFromUrl, usePageContent, usePageMeta } from '../i18n/i18n';

const lang = getLangFromUrl(Astro.url);
const content = usePageContent(lang, 'access');
const meta = usePageMeta(lang, 'access');
---

<BaseLayout title={meta.title} description={meta.description}>
  <Logo />
  <AccessPage lang={lang} content={content} />
</BaseLayout>
