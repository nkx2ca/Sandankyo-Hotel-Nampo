---
import BaseLayout from '../layouts/BaseLayout.astro';
import GalleryPage from '../components/pages/GalleryPage.astro';
import { getLangFromUrl, usePageContent } from '../i18n/i18n';

const lang = getLangFromUrl(Astro.url);
const content = usePageContent(lang, 'gallery');
---

<BaseLayout>
  <GalleryPage lang={lang} content={content} />
</BaseLayout>
