---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactPage from '../components/pages/ContactPage.astro';
import { getLangFromUrl, usePageContent } from '../i18n/i18n';

const lang = getLangFromUrl(Astro.url);
const content = usePageContent(lang, 'contact');
---

<BaseLayout>
  <ContactPage lang={lang} content={content} />
</BaseLayout>
