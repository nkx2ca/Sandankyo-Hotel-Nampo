---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLangFromUrl, useTranslations } from '../i18n/i18n';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<BaseLayout>
  <main class="contact">
    <div class="container">
      <h1 class="page-title">お問い合わせ</h1>

      <div class="content">
        <section class="contact-section">
          <h2 class="section-title">お電話でのお問い合わせ</h2>
          <div class="contact-info">
            <p class="hotel-name">三段峡ホテル 南峰</p>
            <p class="tel-number">
              <a href="tel:0826-28-2308">TEL: 0826-28-2308</a>
            </p>
          </div>
        </section>

        <section class="contact-section">
          <h2 class="section-title">所在地</h2>
          <div class="contact-info">
            <p class="address">{t('address')}</p>
          </div>
        </section>

        <section class="contact-section">
          <h2 class="section-title">メールでのお問い合わせ</h2>
          <div class="contact-info">
            <p class="email-note">
              メールでのお問い合わせは、下記の内容をご記入の上、お送りください。<br/>
              折り返し担当者よりご連絡させていただきます。
            </p>
            <ul class="email-requirements">
              <li>お名前</li>
              <li>ご連絡先（電話番号・メールアドレス）</li>
              <li>お問い合わせ内容</li>
            </ul>
            <p class="email-address">
              <a href="mailto:contact@sandankyo.co.jp">contact@sandankyo.co.jp</a>
            </p>
            <p class="response-note">
              ※ お問い合わせ内容により、回答までにお時間をいただく場合がございます。<br/>
            </p>
          </div>
        </section>

        <section class="contact-section">
          <h2 class="section-title">アクセス</h2>
          <div class="contact-info">
            <p class="access-note">
              詳しいアクセス方法につきましては、<a href="/access" class="access-link">アクセスページ</a>をご覧ください。
            </p>
          </div>
        </section>

        <section class="notice-section">
          <h3 class="notice-title">ご宿泊予約について</h3>
          <p class="notice-text">
            ご宿泊予約は、お電話またはオンライン予約システムにて承っております。<br/>
            オンライン予約は、当ページの「ご予約」ボタンよりお進みください。
          </p>
        </section>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .contact {
    min-height: 100vh;
    padding: 150px 20px 100px;
    background-color: #4e4c43;
  }

  .container {
    max-width: 1240px;
    height: auto;
    padding: 0 20px;
    margin: 0 auto;
  }

  .page-title {
    font-size: 32px;
    letter-spacing: 4px;
    text-align: center;
    margin-bottom: 60px;
    font-weight: normal;
    color: #fff;
  }

  .content {
    background-color: rgba(255, 255, 255, 0.05);
    padding: 40px;
    border-radius: 8px;
  }

  .contact-section {
    margin-bottom: 50px;
    padding-bottom: 40px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .contact-section:last-of-type {
    border-bottom: none;
    margin-bottom: 40px;
  }

  .section-title {
    font-size: 18px;
    font-weight: normal;
    letter-spacing: 2px;
    color: #fff;
    margin: 0 0 25px 0;
    padding-bottom: 10px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.2);
  }

  .contact-info {
    padding-left: 10px;
  }

  .hotel-name {
    font-size: 20px;
    letter-spacing: 2px;
    color: #fff;
    margin: 0 0 15px 0;
  }

  .tel-number {
    font-size: 24px;
    letter-spacing: 1px;
    margin: 0 0 15px 0;
  }

  .tel-number a {
    color: #fff;
    text-decoration: none;
    transition: opacity 0.3s;
  }

  .tel-number a:hover {
    opacity: 0.7;
  }

  .hours {
    font-size: 14px;
    letter-spacing: 1px;
    color: rgba(255, 255, 255, 0.8);
    margin: 0;
  }

  .address {
    font-size: 16px;
    line-height: 1.8;
    letter-spacing: 1px;
    color: #fff;
    margin: 0;
  }

  .email-note {
    font-size: 14px;
    line-height: 1.9;
    letter-spacing: 0.5px;
    color: #fff;
    margin: 0 0 20px 0;
  }

  .email-requirements {
    list-style: none;
    padding-left: 0;
    margin: 0 0 25px 0;
  }

  .email-requirements li {
    font-size: 14px;
    line-height: 1.8;
    letter-spacing: 0.5px;
    color: #fff;
    padding-left: 1.2em;
    position: relative;
    margin-bottom: 8px;
  }

  .email-requirements li::before {
    content: "・";
    position: absolute;
    left: 0;
  }

  .email-address {
    font-size: 18px;
    letter-spacing: 1px;
    margin: 0 0 20px 0;
  }

  .email-address a {
    color: #fff;
    text-decoration: underline;
    transition: opacity 0.3s;
  }

  .email-address a:hover {
    opacity: 0.7;
  }

  .response-note {
    font-size: 12px;
    line-height: 1.8;
    letter-spacing: 0.5px;
    color: rgba(255, 255, 255, 0.7);
    margin: 0;
  }

  .access-note {
    font-size: 14px;
    line-height: 1.9;
    letter-spacing: 0.5px;
    color: #fff;
    margin: 0;
  }

  .access-link {
    color: #fff;
    text-decoration: underline;
    transition: opacity 0.3s;
  }

  .access-link:hover {
    opacity: 0.7;
  }

  .notice-section {
    background-color: rgba(255, 255, 255, 0.08);
    padding: 30px;
    border-radius: 4px;
    border-left: 3px solid rgba(255, 255, 255, 0.3);
  }

  .notice-title {
    font-size: 16px;
    font-weight: normal;
    letter-spacing: 2px;
    color: #fff;
    margin: 0 0 15px 0;
  }

  .notice-text {
    font-size: 14px;
    line-height: 1.9;
    letter-spacing: 0.5px;
    color: #fff;
    margin: 0;
  }

  @media screen and (max-width: 960px) {
    .contact {
      padding: 120px 15px 80px;
    }

    .page-title {
      font-size: 24px;
      margin-bottom: 40px;
    }

    .content {
      padding: 25px 20px;
    }

    .contact-section {
      margin-bottom: 40px;
      padding-bottom: 30px;
    }

    .section-title {
      font-size: 16px;
      margin-bottom: 20px;
    }

    .hotel-name {
      font-size: 18px;
    }

    .tel-number {
      font-size: 20px;
    }

    .hours,
    .address,
    .email-note,
    .email-requirements li,
    .access-note,
    .notice-text {
      font-size: 13px;
    }

    .email-address {
      font-size: 16px;
    }

    .notice-section {
      padding: 20px;
    }

    .notice-title {
      font-size: 15px;
    }
  }
</style>
