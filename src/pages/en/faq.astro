---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLangFromUrl } from '../../i18n/i18n';

const lang = getLangFromUrl(Astro.url);

const faqs = [
  {
    category: "Reservations",
    items: [
      {
        question: "How can I make a reservation?",
        answer: "Reservations can be made by phone (TEL: 0826-28-2308) or through our online reservation system. For online reservations, please click the 'Book Now' button on the right side of this website."
      },
      {
        question: "Until when can I cancel my reservation?",
        answer: "Cancellations are possible, but cancellation fees apply. Fees are 20% from 7 days before, 50% from 3 days before, 80% from the day before, and 100% for same-day cancellations or no-shows. Please refer to our accommodation terms for details."
      },
      {
        question: "Can I change my reservation?",
        answer: "Changes to your reservation can be made by phone. Please note that changes may not be possible depending on room availability, so please contact us as early as possible."
      }
    ]
  },
  {
    category: "Check-in/Check-out",
    items: [
      {
        question: "What are the check-in and check-out times?",
        answer: "Check-in is from 3:00 PM, and check-out is until 11:00 AM."
      },
      {
        question: "Can I store my luggage if I arrive before check-in time?",
        answer: "Yes, we can store your luggage at the front desk even before check-in time."
      },
      {
        question: "Is late check-out available?",
        answer: "Late check-out is available for a fee, subject to room availability. Fees are 50% of room rate for up to 2 hours and 100% for up to 5 hours. Please inquire at the front desk."
      }
    ]
  },
  {
    category: "Rooms & Facilities",
    items: [
      {
        question: "Are amenities provided in the rooms?",
        answer: "We provide basic amenities including bath towels, face towels, toothbrushes, shampoo, conditioner, and body soap."
      },
      {
        question: "Is Wi-Fi available?",
        answer: "Yes, free Wi-Fi is available in all guest rooms and common areas throughout the hotel."
      },
      {
        question: "Are non-smoking rooms available?",
        answer: "All rooms in the hotel are non-smoking. Smoking is only permitted in designated smoking areas."
      },
      {
        question: "Are barrier-free rooms available?",
        answer: "We have barrier-free rooms available. Please let us know when making your reservation."
      }
    ]
  },
  {
    category: "Dining",
    items: [
      {
        question: "Are meal plans available?",
        answer: "Yes, we offer plans with breakfast and plans with dinner and breakfast. You can enjoy Japanese cuisine featuring seasonal ingredients."
      },
      {
        question: "Can you accommodate food allergies?",
        answer: "If you inform us in advance, we will accommodate allergies to the best of our ability. Please let us know when making your reservation."
      },
      {
        question: "What are the restaurant operating hours?",
        answer: "Breakfast is served from 7:00 AM to 9:00 AM, and dinner from 6:00 PM to 8:00 PM (last order at 7:30 PM)."
      }
    ]
  },
  {
    category: "Hotel Facilities",
    items: [
      {
        question: "Is there a hot spring?",
        answer: "We have a large communal bath. For details including operating hours, please see our facilities page."
      },
      {
        question: "Is parking available?",
        answer: "Yes, free parking is available. Please note that spaces are limited and may be full."
      },
      {
        question: "Is there a shop?",
        answer: "There is a shop area near the front desk where you can purchase local souvenirs and other items."
      }
    ]
  },
  {
    category: "Payment",
    items: [
      {
        question: "What payment methods are accepted?",
        answer: "We accept cash, credit cards, and traveler's checks. Accepted credit cards are VISA, MasterCard, JCB, AMEX, and Diners."
      },
      {
        question: "Is advance payment possible?",
        answer: "For online reservations, advance payment is available for certain plans."
      }
    ]
  },
  {
    category: "Others",
    items: [
      {
        question: "Can I bring pets?",
        answer: "We apologize, but pets are not allowed except for guide dogs."
      },
      {
        question: "How much does accommodation cost for children?",
        answer: "For children aged 3-12, a facility fee of 3,300 yen (tax included) per night applies. Additional charges apply for meals and bedding if requested. Children under 2 years old stay free if no bedding or meals are needed."
      },
      {
        question: "What are the nearby tourist attractions?",
        answer: "Our hotel is located at the entrance of Sandankyo, a Special Place of Scenic Beauty. You can enjoy the gorge's beautiful scenery, and nearby attractions include Nukui Dam and Shinnyuzan Mountain."
      },
      {
        question: "Is there a shuttle service from the nearest station?",
        answer: "We apologize, but we do not offer regular shuttle service. We recommend coming by car. If using public transportation, please check our access page."
      }
    ]
  }
];
---

<BaseLayout>
  <main class="faq">
    <div class="container">
      <h1 class="page-title">Frequently Asked Questions</h1>

      <div class="content">
        <div class="intro">
          <p>We have compiled answers to frequently asked questions from our guests.</p>
          <p>If you have questions not listed here, please feel free to contact us via our <a href="/en/contact" class="contact-link">Contact page</a>.</p>
        </div>

        {faqs.map((category) => (
          <section class="faq-category">
            <h2 class="category-title">{category.category}</h2>
            <div class="faq-list">
              {category.items.map((item, index) => (
                <details class="faq-item">
                  <summary class="faq-question">
                    <span class="question-icon">Q</span>
                    <span class="question-text">{item.question}</span>
                    <span class="toggle-icon">
                      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M19 9l-7 7-7-7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </span>
                  </summary>
                  <div class="faq-answer">
                    <span class="answer-icon">A</span>
                    <p class="answer-text">{item.answer}</p>
                  </div>
                </details>
              ))}
            </div>
          </section>
        ))}
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .faq {
    min-height: 100vh;
    padding: 150px 20px 100px;
    background-color: #4e4c43;
  }

  .container {
    max-width: 1240px;
    height: auto;
    padding: 0 20px;
    margin: 0 auto;
  }

  .page-title {
    font-size: 32px;
    letter-spacing: 4px;
    text-align: center;
    margin-bottom: 60px;
    font-weight: normal;
    color: #fff;
  }

  .content {
    background-color: rgba(255, 255, 255, 0.05);
    padding: 40px;
    border-radius: 8px;
  }

  .intro {
    margin-bottom: 50px;
    padding-bottom: 30px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.2);
    text-align: center;
  }

  .intro p {
    font-size: 14px;
    line-height: 1.9;
    letter-spacing: 0.5px;
    color: #fff;
    margin: 8px 0;
  }

  .contact-link {
    color: #fff;
    text-decoration: underline;
    transition: opacity 0.3s;
  }

  .contact-link:hover {
    opacity: 0.7;
  }

  .faq-category {
    margin-bottom: 50px;
  }

  .faq-category:last-of-type {
    margin-bottom: 40px;
  }

  .category-title {
    font-size: 20px;
    font-weight: normal;
    letter-spacing: 2px;
    color: #fff;
    margin: 0 0 25px 0;
    padding-bottom: 12px;
    border-bottom: 2px solid rgba(255, 255, 255, 0.3);
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 15px;
  }

  .faq-item {
    background-color: rgba(255, 255, 255, 0.03);
    border-radius: 4px;
    overflow: hidden;
    transition: background-color 0.3s;
  }

  .faq-item:hover {
    background-color: rgba(255, 255, 255, 0.05);
  }

  .faq-item[open] {
    background-color: rgba(255, 255, 255, 0.08);
  }

  .faq-question {
    display: flex;
    align-items: center;
    padding: 20px;
    cursor: pointer;
    list-style: none;
    position: relative;
    user-select: none;
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .question-icon {
    flex-shrink: 0;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background-color: rgba(255, 255, 255, 0.15);
    color: #fff;
    font-size: 14px;
    font-weight: bold;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-right: 15px;
  }

  .question-text {
    flex: 1;
    font-size: 16px;
    letter-spacing: 0.5px;
    color: #fff;
    padding-right: 35px;
  }

  .toggle-icon {
    position: absolute;
    right: 20px;
    color: #fff;
    transition: transform 0.3s;
  }

  .faq-item[open] .toggle-icon {
    transform: rotate(180deg);
  }

  .faq-answer {
    display: flex;
    padding: 0 20px 25px 20px;
    align-items: flex-start;
  }

  .answer-icon {
    flex-shrink: 0;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background-color: rgba(255, 255, 255, 0.15);
    color: #fff;
    font-size: 14px;
    font-weight: bold;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-right: 15px;
  }

  .answer-text {
    font-size: 14px;
    line-height: 1.9;
    letter-spacing: 0.5px;
    color: rgba(255, 255, 255, 0.9);
    margin: 0;
    flex: 1;
  }

  @media screen and (max-width: 960px) {
    .faq {
      padding: 120px 15px 80px;
    }

    .page-title {
      font-size: 24px;
      margin-bottom: 40px;
    }

    .content {
      padding: 25px 20px;
    }

    .intro {
      margin-bottom: 40px;
      padding-bottom: 25px;
    }

    .intro p {
      font-size: 13px;
    }

    .faq-category {
      margin-bottom: 40px;
    }

    .category-title {
      font-size: 18px;
      margin-bottom: 20px;
      padding-bottom: 10px;
    }

    .faq-question {
      padding: 15px;
    }

    .question-icon,
    .answer-icon {
      width: 24px;
      height: 24px;
      font-size: 12px;
      margin-right: 12px;
    }

    .question-text {
      font-size: 14px;
      padding-right: 25px;
    }

    .toggle-icon {
      right: 15px;
    }

    .faq-answer {
      padding: 0 15px 20px 15px;
    }

    .answer-text {
      font-size: 13px;
      line-height: 1.8;
    }
  }
</style>

