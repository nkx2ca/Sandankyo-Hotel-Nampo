---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getRelativeLocaleUrl, getAbsoluteLocaleUrl } from 'astro:i18n';
import { getLangFromUrl, useTranslations, generateLocalePaths, generateLocaleUrls} from '../../i18n/i18n';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const localePaths = generateLocalePaths(Astro.url);
---

<BaseLayout>
  <div class="loading">
    <img class="loading_logo" src=`${import.meta.env.BASE_URL}logo_with_text_white.png`/>
  </div>

  <section class="hero-section">
    <div class="slideshow">
      <div class="hero-filter">
        <div class="slide active" style={`background-image: url(${import.meta.env.BASE_URL}hero-sandankyo-gorge.jpeg)`}></div>
        <div class="slide" style={`background-image: url(${import.meta.env.BASE_URL}kurobuchi.jpg)`}></div>
        <div class="slide" style={`background-image: url(${import.meta.env.BASE_URL}hotel_extelia.jpg)`}></div>
      </div>
    </div>

    <div class="hero-text">
      <h2 class="hero-title">A Moment of Stillness, Awash in Green</h2>
      <p class="hero-subtitle">翠に染まる、癒しのひととき</p>
    </div>

    <div class="slide-indicators">
      <button class="indicator active" data-slide="0" aria-label="Slide 1"></button>
      <button class="indicator" data-slide="1" aria-label="Slide 2"></button>
      <button class="indicator" data-slide="2" aria-label="Slide 3"></button>
    </div>
  </section>

  <section class="news-section">
    <div class="container">
      <h2 class="news-title">NEWS</h2>
      <ul class="news-list">
        <li class="news-item">
          <span class="news-date">2026.09.01</span>
          <a href={getRelativeLocaleUrl(lang, "/news/article/1")} class="news-link">Autumn Special Plan Announcement</a>
        </li>
        <li class="news-item">
          <span class="news-date">2026.08.15</span>
          <a href={getRelativeLocaleUrl(lang, "/news/article/2")} class="news-link">Summer Closure Notice</a>
        </li>
        <li class="news-item">
          <span class="news-date">2026.07.20</span>
          <a href={getRelativeLocaleUrl(lang, "/news/article/3")} class="news-link">New Guest Rooms Now Open</a>
        </li>
      </ul>
      <div class="news-more">
        <a href={getRelativeLocaleUrl(lang, "/news")} class="news-more-link">View All News</a>
      </div>
    </div>
  </section>

  <section class="intro-section">
    <div class="container">
      <div class="intro-text">
        <p>Sandankyo was once an unknown hidden sanctuary.</p>
        <p>Captivated by its majestic landscape and natural beauty</p>
        <p>that combines garden-like elegance,</p>
        <p>photographer Kuma Nampo devoted himself to this place.</p>
        <p>Together with local elementary school teacher Saito Rosui,</p>
        <p>he shared its allure with the world,</p>
        <p>leading Sandankyo to become one of Japan's most renowned scenic spots.</p>
        <p>Protected by our predecessors, this Sandankyo</p>
        <p>changes its expression with each season,</p>
        <p>bringing peace to all who visit.</p>
        <br/>
        <p>"A Moment of Stillness, Awash in Green"</p>
        <p>翠に染まる、癒しのひととき</p>
        <br/>
        <p>Crystal-clear water flowing through the ravine,</p>
        <p>the fresh green of flourishing plants,</p>
        <p>and the gentle light woven by nature.</p>
        <p>Entrust yourself to the emerald world</p>
        <p>created by Sandankyo's valley,</p>
        <p>and find balance for body and mind.</p>
        <p>In the slowly changing passage of time,</p>
        <p>discover moments to face yourself.</p>
        <p>Feel the seasons, savor the land,</p>
        <p>and enjoy a moment of healing.</p>
      </div>
    </div>
  </section>

</BaseLayout>

<script>
  const loading = document.querySelector('.loading');

  window.addEventListener('load', () => {
    setTimeout(() => {
      loading?.classList.add('fade-out');
    }, 1500);
  });

  // Slideshow functionality
  const slides = document.querySelectorAll('.slide');
  const indicators = document.querySelectorAll('.indicator');
  let currentSlide = 0;
  let slideInterval;

  function showSlide(index) {
    slides.forEach((slide, i) => {
      slide.classList.toggle('active', i === index);
    });
    indicators.forEach((indicator, i) => {
      indicator.classList.toggle('active', i === index);
    });
    currentSlide = index;
  }

  function nextSlide() {
    const next = (currentSlide + 1) % slides.length;
    showSlide(next);
  }

  function resetInterval() {
    clearInterval(slideInterval);
    slideInterval = setInterval(nextSlide, 10000);
  }

  // Auto advance
  slideInterval = setInterval(nextSlide, 10000);

  // Indicators
  indicators.forEach((indicator, index) => {
    indicator.addEventListener('click', () => {
      showSlide(index);
      resetInterval();
    });
  });
</script>

<style>
 .loading {
   width: 100vw;
   height: 100vh;
   height: 100dvh;
   background-color: #000;
   position: fixed;
   top: 0;
   left: 0;
   z-index: 500;
   display: flex;
   justify-content: center;
   align-items: center;
   transition: opacity 1.0s ease;
 }

 .loading.fade-out {
   opacity: 0;
   pointer-events: none;
 }

 .loading_logo {
   width: 180px;
   z-index: 510;
 }

 .hero-section {
   position: relative;
   width: 100%;
   height: 100vh;
   height: 100dvh;
   overflow: hidden;
 }

 .slideshow {
   position: absolute;
   width: 100%;
   height: 100%;
   top: 0;
   left: 0;
   z-index: 0;
   background-color: #000;
 }

 .slide {
   width: 100%;
   height: 100%;
   position: absolute;
   top: 0;
   left: 0;
   background-size: cover;
   background-position: center;
   opacity: 0;
   transition: opacity 1.5s ease-in-out;
   pointer-events: none;
   z-index: 1;
   filter: brightness(0.7);
 }

 .slide::before {
   content: '';
   position: absolute;
   top: 0;
   left: 0;
   width: 100%;
   height: 100%;
   background: rgba(0, 0, 0, 0.1);
   z-index: 1;
 }

 .slide.active {
   opacity: 1;
   z-index: 2;
 }

 .hero-text {
   position: absolute;
   bottom: 50px;
   left: 50px;
   z-index: 10;
   color: #fff;
 }

 .hero-title {
   font-size: 20px;
   font-weight: normal;
   letter-spacing: 3px;
   margin: 0 0 10px 0;
   text-shadow: 2px 2px 8px rgba(0, 0, 0, 0.8);
 }

 .hero-subtitle {
   font-size: 16px;
   font-weight: normal;
   letter-spacing: 2px;
   margin: 0;
   opacity: 0.9;
   text-shadow: 1px 1px 6px rgba(0, 0, 0, 0.8);
 }

 .slide-indicators {
   position: absolute;
   bottom: 50px;
   left: 50%;
   transform: translateX(-50%);
   z-index: 10;
   display: flex;
   gap: 16px;
   align-items: center;
 }

 .indicator {
   width: 40px;
   height: 3px;
   border-radius: 2px;
   background: rgba(255, 255, 255, 0.4);
   border: none;
   cursor: pointer;
   transition: all 0.4s ease;
   padding: 0;
   position: relative;
   overflow: hidden;
 }

 .indicator::before {
   content: '';
   position: absolute;
   top: 0;
   left: 0;
   width: 0;
   height: 100%;
   background: rgba(255, 255, 255, 1);
   transition: width 0.4s ease;
 }

 .indicator.active {
   background: rgba(255, 255, 255, 0.6);
 }

 .indicator.active::before {
   width: 100%;
 }

 .indicator:hover {
   background: rgba(255, 255, 255, 0.7);
   transform: scaleX(1.1);
 }

 .container {
   max-width: 1240px;
   height: 100%;
   padding: 0 20px;
   margin: 0 auto;
 }

 .opening-section {
   width: 100%;
   height: 400px;
   background-color: #fff;
 }

 .opening-section .container {
   display: flex;
   flex-direction: column;
   justify-content: center;
   align-items: center;
   text-align: center;
 }

 .opening-date {
   font-size: 32px;
   letter-spacing: 4px;
   margin: 0 0 30px 0;
   font-weight: normal;
   color: #000;
 }

 .opening-text {
   font-size: 14px;
   line-height: 2;
   letter-spacing: 1px;
   margin: 4px 0;
   color: #000;
 }

 .news-section {
   width: 100%;
   padding: 100px 0;
   background-color: #f4f1e8;
 }

 .news-title {
   font-size: 32px;
   letter-spacing: 8px;
   margin-top: 0;
   margin-bottom: 40px;
   text-align: center;
   font-weight: normal;
   color: #000;
 }

 .news-list {
   max-width: 800px;
   list-style: none;
   padding: 0;
   margin: 0 auto 60px auto;
 }

 .news-item {
   border-bottom: 1px solid rgba(0, 0, 0, 0.3);
   padding: 20px 0;
   display: flex;
   align-items: center;
   gap: 20px;
   transition: opacity 0.3s;
 }

 .news-item:hover {
   opacity: 0.7;
 }

 .news-date {
   font-size: 14px;
   letter-spacing: 2px;
   color: rgba(0, 0, 0, 0.8);
   white-space: nowrap;
 }

 .news-link {
   color: #000;
   text-decoration: none;
   font-size: 16px;
   letter-spacing: 2px;
   flex: 1;
 }

 .news-more {
   text-align: center;
 }

 .news-more-link {
   color: #000;
   text-decoration: none;
   font-size: 14px;
   letter-spacing: 3px;
   padding-bottom: 5px;
   border-bottom: 1px solid #000;
   transition: opacity 0.3s;
 }

 .news-more-link:hover {
   opacity: 0.7;
 }

 .intro-section {
   width: 100%;
   padding: 100px 0;
   background-image: url('/moss.jpg');
   background-size: 100% auto;
   background-position: center;
   background-repeat: no-repeat;
 }

 .intro-text {
   width: 100%;
   height: 100%;
   color: #fff;
 }

 .intro-text p {
   font-size: 16px;
   line-height: 2;
   letter-spacing: 1px;
   text-align: left;
   margin: 0;
 }

 .intro-text br {
   display: block;
   content: "";
   margin-top: 20px;
 }

 /* モバイル対応 */
 @media screen and (max-width: 960px) {
   .loading_logo {
     width: 120px;
   }

   .hero-text {
     bottom: 80px;
     left: 20px;
     right: 20px;
   }

   .hero-title {
     font-size: 18px;
     letter-spacing: 2px;
   }

   .hero-subtitle {
     font-size: 12px;
     letter-spacing: 1px;
   }

   .slide-indicators {
     bottom: 30px;
     gap: 12px;
   }

   .indicator {
     width: 30px;
     height: 2px;
   }

   .container {
     padding: 0 15px;
   }

   .opening-section {
     height: auto;
     padding: 60px 0;
   }

   .opening-date {
     font-size: 24px;
     letter-spacing: 3px;
     margin-bottom: 20px;
   }

   .opening-text {
     font-size: 13px;
     line-height: 1.8;
   }

   .news-section {
     padding: 60px 0;
   }

   .news-title {
     font-size: 24px;
     letter-spacing: 6px;
     margin-bottom: 30px;
   }

   .news-list {
     margin-bottom: 40px;
   }

   .news-item {
     flex-direction: column;
     align-items: flex-start;
     gap: 8px;
     padding: 15px 0;
   }

   .news-date {
     font-size: 12px;
     letter-spacing: 1px;
   }

   .news-link {
     font-size: 14px;
     letter-spacing: 1px;
   }

   .news-more-link {
     font-size: 13px;
     letter-spacing: 2px;
   }

   .intro-section {
     padding: 60px 0;
     background-size: cover;
   }

   .intro-text p {
     font-size: 14px;
     line-height: 1.9;
     letter-spacing: 0.5px;
   }

   .intro-text br {
     margin-top: 15px;
   }
 }

</style>
