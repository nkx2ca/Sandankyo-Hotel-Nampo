---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getRelativeLocaleUrl, getAbsoluteLocaleUrl } from 'astro:i18n';
import { getLangFromUrl, useTranslations, generateLocalePaths, generateLocaleUrls} from '../../i18n/i18n';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const localePaths = generateLocalePaths(Astro.url);
---

<BaseLayout>
  <div class="loading">
    <img class="loading_logo" src=`${import.meta.env.BASE_URL}logo_with_text_white.png`/>
  </div>

  <section class="hero-section">
    <div class="slideshow">
      <div class="slide active" style={`background-image: url(${import.meta.env.BASE_URL}hero-sandankyo-gorge.jpeg)`}></div>
      <div class="slide" style={`background-image: url(${import.meta.env.BASE_URL}kurobuchi.jpg)`}></div>
      <div class="slide" style={`background-image: url(${import.meta.env.BASE_URL}hotel_extelia.jpg)`}></div>
    </div>

    <div class="slide-indicators">
      <button class="indicator active" data-slide="0" aria-label="Slide 1"></button>
      <button class="indicator" data-slide="1" aria-label="Slide 2"></button>
      <button class="indicator" data-slide="2" aria-label="Slide 3"></button>
    </div>

    <div class="hero-content">
      <a href={getRelativeLocaleUrl(lang, "/")}>
        <img class="top_logo" src=`${import.meta.env.BASE_URL}logo_with_text_white.png`/>
      </a>
    </div>
  </section>

  <section class="opening-section">
    <div class="container">
      <h3 class="opening-date">Opening November 14, 2026</h3>
      <p class="opening-text">A grand gorge stretching approximately 16 kilometers within Nishi-Chugoku Sanchi Quasi-National Park.</p>
      <p class="opening-text">Sandankyo Hotel Nampo will reopen at the gateway to Sandankyo, a Special Place of Scenic Beauty.</p>
    </div>
  </section>

  <section class="news-section">
    <div class="container">
      <h2 class="news-title">NEWS</h2>
      <ul class="news-list">
        <li class="news-item">
          <span class="news-date">2026.09.01</span>
          <a href={getRelativeLocaleUrl(lang, "/news/1")} class="news-link">Autumn Special Plan Announcement</a>
        </li>
        <li class="news-item">
          <span class="news-date">2026.08.15</span>
          <a href={getRelativeLocaleUrl(lang, "/news/2")} class="news-link">Summer Closure Notice</a>
        </li>
        <li class="news-item">
          <span class="news-date">2026.07.20</span>
          <a href={getRelativeLocaleUrl(lang, "/news/3")} class="news-link">New Guest Rooms Now Open</a>
        </li>
      </ul>
      <div class="news-more">
        <a href={getRelativeLocaleUrl(lang, "/news")} class="news-more-link">View All News</a>
      </div>
    </div>
  </section>

  <section class="intro-section">
    <div class="intro-text">
      <p>Sandankyo was once an "unknown hidden sanctuary."</p>
      <p>Captivated by its majestic landscape and natural beauty</p>
      <p>that combines garden-like elegance,</p>
      <p>photographer Kuma Nampo devoted himself to this place.</p>
      <br/>
      <p>Together with local elementary school teacher Saito Rosui,</p>
      <p>he shared its allure with the world,</p>
      <p>leading Sandankyo to become one of Japan's most renowned scenic spots.</p>
      <br/>
      <p>"A Moment of Stillness, Awash in Green"</p>
      <p>翠に染まる、癒しのひととき</p>
      <br/>
      <p>Crystal-clear water flowing through the ravine,</p>
      <p>the fresh green of flourishing plants,</p>
      <p>and the gentle light woven by nature.</p>
      <p>Entrust yourself to the emerald world</p>
      <p>created by Sandankyo's valley,</p>
      <p>and find balance for body and mind.</p>
      <p>In the slowly changing passage of time,</p>
      <p>discover moments to face yourself.</p>
      <br/>
      <p>Feel the seasons, savor the land,</p>
      <p>and enjoy a moment of stillness, awash in green.</p>
    </div>
  </section>
</BaseLayout>

<script>
  const loading = document.querySelector('.loading');

  window.addEventListener('load', () => {
    setTimeout(() => {
      loading?.classList.add('fade-out');
    }, 1500);
  });

  // Slideshow functionality
  const slides = document.querySelectorAll('.slide');
  const indicators = document.querySelectorAll('.indicator');
  let currentSlide = 0;
  let slideInterval;

  function showSlide(index) {
    slides.forEach((slide, i) => {
      slide.classList.toggle('active', i === index);
    });
    indicators.forEach((indicator, i) => {
      indicator.classList.toggle('active', i === index);
    });
    currentSlide = index;
  }

  function nextSlide() {
    const next = (currentSlide + 1) % slides.length;
    showSlide(next);
  }

  function resetInterval() {
    clearInterval(slideInterval);
    slideInterval = setInterval(nextSlide, 10000);
  }

  // Auto advance
  slideInterval = setInterval(nextSlide, 10000);

  // Indicators
  indicators.forEach((indicator, index) => {
    indicator.addEventListener('click', () => {
      showSlide(index);
      resetInterval();
    });
  });
</script>

<style>
  @media screen and (max-width: 960px) {
  }

  .loading {
    width: 100vw;
    height: 100vh;
    background-color: #000;
    position: fixed;
    top: 0;
    left: 0;
    z-index: 500;
    display: flex;
    justify-content: center;
    align-items: center;
    transition: opacity 1.0s ease;
  }
 
  .loading.fade-out {
    opacity: 0;
    pointer-events: none;
  }
 
  .loading_logo {
    width: 180px;
    z-index: 510;
  }
 
  /* ヒーローセクション */
  .hero-section {
    position: relative;
    width: 100%;
    height: 100vh;
    overflow: hidden;
  }
 
  .slideshow {
    position: absolute;
    width: 100%;
    height: 100%;
    top: 0;
    left: 0;
    z-index: 0;
    background-color: #000;
  }
 
  .slide {
    width: 100%;
    height: 100%;
    position: absolute;
    top: 0;
    left: 0;
    background-size: cover;
    background-position: center;
    opacity: 0;
    transition: opacity 1.5s ease-in-out;
    pointer-events: none;
    z-index: 1;
    filter: brightness(1);
  }
 
  .slide::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.1);
    z-index: 1;
  }
 
  .slide.active {
    opacity: 1;
    z-index: 2;
  }
 
  .slide-indicators {
    position: absolute;
    bottom: 50px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 10;
    display: flex;
    gap: 16px;
    align-items: center;
  }
 
  .indicator {
    width: 40px;
    height: 3px;
    border-radius: 2px;
    background: rgba(255, 255, 255, 0.4);
    border: none;
    cursor: pointer;
    transition: all 0.4s ease;
    padding: 0;
    position: relative;
    overflow: hidden;
  }
 
  .indicator::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 0;
    height: 100%;
    background: rgba(255, 255, 255, 1);
    transition: width 0.4s ease;
  }
 
  .indicator.active {
    background: rgba(255, 255, 255, 0.6);
  }
 
  .indicator.active::before {
    width: 100%;
  }
 
  .indicator:hover {
    background: rgba(255, 255, 255, 0.7);
    transform: scaleX(1.1);
  }
 
  .hero-content {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
  }
 
  .top_logo {
    position: absolute;
    width: 100px;
    margin-top: 15px;
    margin-left: 30px;
    top: 0px;
    left: 0px;
  }
 
  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 40px;
  }
 
  /* 開業情報セクション */
  .opening-section {
    width: 100%;
    height: 100vh;
    background-color: #fff;
    color: #333;
    display: flex;
    align-items: flex-end;
    padding-bottom: 100px;
  }

  .opening-section .container {
    text-align: left;
  }

  .opening-date {
    font-size: 32px;
    letter-spacing: 4px;
    margin-bottom: 30px;
    font-weight: normal;
  }

  .opening-text {
    font-size: 14px;
    line-height: 2;
    letter-spacing: 1px;
    margin: 8px 0;
  }
 
  /* お知らせセクション */
  .news-section {
    padding: 100px 0;
    background-color: rgb(78, 76, 67);
    color: #fff;
  }
 
  .news-title {
    font-size: 32px;
    letter-spacing: 8px;
    margin-top: 0;
    margin-bottom: 40px;
    text-align: center;
    font-weight: normal;
  }
 
  .news-list {
    list-style: none;
    padding: 0;
    margin: 0 0 40px 0;
    max-width: 800px;
    margin-left: auto;
    margin-right: auto;
  }
 
  .news-item {
    border-bottom: 1px solid rgba(255, 255, 255, 0.3);
    padding: 20px 0;
    display: flex;
    align-items: center;
    gap: 20px;
    transition: opacity 0.3s;
  }
 
  .news-item:hover {
    opacity: 0.7;
  }
 
  .news-date {
    font-size: 14px;
    letter-spacing: 2px;
    color: rgba(255, 255, 255, 0.8);
    white-space: nowrap;
  }
 
  .news-link {
    color: #fff;
    text-decoration: none;
    font-size: 16px;
    letter-spacing: 2px;
    flex: 1;
  }
 
  .news-more {
    text-align: center;
    margin-top: 30px;
  }
 
  .news-more-link {
    color: #fff;
    text-decoration: none;
    font-size: 14px;
    letter-spacing: 3px;
    padding-bottom: 5px;
    border-bottom: 1px solid #fff;
    transition: opacity 0.3s;
  }
 
  .news-more-link:hover {
    opacity: 0.7;
  }
 
  .intro-section {
    width: 100%;
    padding: 100px 0;
    background-image: url('/moss.jpg');
    background-size: 100% auto;
    background-position: center;
    background-repeat: no-repeat;
  }
 
  .intro-text {
    max-width: 1240px;
    height: 100%;
    padding: 0 20px;
    margin: 0 auto;
    color: #fff;
  }
 
  .intro-text p {
    font-size: 16px;
    line-height: 2;
    letter-spacing: 1px;
    text-align: left;
    margin: 0;
  }
 
  .intro-text br {
    display: block;
    content: "";
    margin-top: 20px;
  }
</style>
