---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { getLangFromUrl, useTranslations } from '../../i18n/i18n';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<BaseLayout>
  <div class="loading">
    <img class="loading_logo" src=`${import.meta.env.BASE_URL}logo_with_text_white.png`/>
  </div>

  <section class="top">
    <div class="top_bg" style={`background-image: url(${import.meta.env.BASE_URL}hero-sandankyo-gorge.jpeg)`}></div>
    <div class="overlay">
      <section class="page-0">
        <a href={getRelativeLocaleUrl(lang, "/")}>
          <img class="top_logo" src=`${import.meta.env.BASE_URL}logo_with_text_white.png`/>
        </a>
      </section>
      <section class="page-0-5">
        <div class="opening-info">
          <h3 class="opening-date">Opening November 14, 2026</h3>
          <p class="opening-text">Located within Fuji-Hakone-Izu National Park, surrounded by 135,500㎡ of vast nature.</p>
          <p class="opening-text">HOTEL THE MITSUI HAKONE will be born in this place where the Mitsui family villas once stood.</p>
        </div>
      </section>
      <section class="page-1">
        <div class="news-section">
          <h2 class="news-title">NEWS</h2>
          <ul class="news-list">
            <li class="news-item">
              <span class="news-date">2026.09.01</span>
              <a href={getRelativeLocaleUrl(lang, "/news/1")} class="news-link">Autumn Special Plan Announcement</a>
            </li>
            <li class="news-item">
              <span class="news-date">2026.08.15</span>
              <a href={getRelativeLocaleUrl(lang, "/news/2")} class="news-link">Summer Closure Notice</a>
            </li>
            <li class="news-item">
              <span class="news-date">2026.07.20</span>
              <a href={getRelativeLocaleUrl(lang, "/news/3")} class="news-link">New Guest Rooms Now Open</a>
            </li>
          </ul>
          <div class="news-more">
            <a href={getRelativeLocaleUrl(lang, "/news")} class="news-more-link">View All News</a>
          </div>
        </div>
      </section>
      <section class="page-2">
        <div class="intro-text">
          <p>Feel the seasons, taste the land, savor the ingredients.</p>
          <p>A place to rediscover your true self and spend time in harmony with nature.</p>
          <br/>
          <p>Away from the bustle of the city,</p>
          <p>Surrounded by greenery with an ocean view,</p>
          <p>SOKI ATAMI awaits.</p>
          <br/>
          <p>SOKI means "pure vessel."</p>
          <p>An inn that welcomes time spent naturally, just as you are.</p>
          <br/>
          <p>Relax in private hot springs in every room,</p>
          <p>Enjoy seasonal ingredients sourced locally,</p>
          <p>Take in the views and find peace.</p>
          <br/>
          <p>In Atami, where hot spring culture has deep roots,</p>
          <p>We offer a stay where modern travelers</p>
          <p>Can care for and rejuvenate themselves.</p>
          <br/>
          <p>Entrust yourself to the seasons and the land,</p>
          <p>And enjoy time spent in harmony with nature.</p>
        </div>
      </section>
    </div>
  </section>

  <script>
    const topSection = document.querySelector('.top');
    const logo = document.querySelector('.top_logo');
    const openingInfo = document.querySelector('.opening-info');

    topSection.addEventListener('scroll', () => {
      if (topSection.scrollTop > 0) {
        logo.classList.add('hidden');
        openingInfo.classList.add('visible');
      } else {
        logo.classList.remove('hidden');
        openingInfo.classList.remove('visible');
      }
    });

    const loading = document.querySelector('.loading');

    window.addEventListener('load', () => {
      setTimeout(() => {
        loading?.classList.add('fade-out');
      }, 1500);
    });
  </script>
</BaseLayout>

<style>
  @media screen and (min-width: 1025px) {
    .loading {
      width: 100vw;
      height: 100vh;
      background-color: #000;
      position: fixed;
      top: 0;
      left: 0;
      z-index: 500;
      display: flex;
      justify-content: center;
      align-items: center;
      transition: opacity 1.0s ease;
    }

    .loading.fade-out {
      opacity: 0;
      pointer-events: none;
    }

    .loading_logo {
      width: 180px;
      z-index: 510;
    }

    .top {
      width: 100vw;
      height: 100vh;
      position: relative;
      overflow-y: auto;
    }

    .top_bg {
      width: 100%;
      height: 100%;
      position: fixed;
      top: 0;
      left: 0;
      background-size: cover;
      background-position: center;
      z-index: 0;
      pointer-events: none;
    }

    .overlay {
      width: 100%;
      min-height: 100vh;
      position: relative;
      z-index: 1;
      display: flex;
      flex-direction: column;
      justify-content: flex-start;
    }

    .top_logo {
      position: absolute;
      width: 80px;
      margin-top: 15px;
      margin-left: 30px;
      top: 0px;
      left: 0px;
      transition: opacity 0.5s ease;
    }

    .top_logo.hidden {
      opacity: 0;
    }

    .page-0 {
      width: 100%;
      height: 100vh;
    }

    .page-0-5 {
      width: 100%;
      height: 50vh;
      display: flex;
      align-items: flex-end;
      padding: 60px 80px 100px;
    }

    .opening-info {
      color: #fff;
      text-align: left;
      opacity: 0;
      transition: opacity 0.5s ease;
    }

    .opening-info.visible {
      opacity: 1;
    }

    .opening-date {
      font-size: 32px;
      letter-spacing: 4px;
      margin-bottom: 30px;
      font-weight: normal;
    }

    .opening-text {
      font-size: 14px;
      line-height: 2;
      letter-spacing: 1px;
      margin: 0;
    }

    .page-1 {
      width: 100%;
      height: auto;
      background-color: rgb(0,0,0,0.5);
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 60px 40px;
    }

    .news-section {
      width: 100%;
      max-width: 800px;
      color: #fff;
    }

    .news-title {
      font-size: 32px;
      letter-spacing: 8px;
      margin-bottom: 40px;
      text-align: center;
      font-weight: normal;
    }

    .news-list {
      list-style: none;
      padding: 0;
      margin: 0 0 40px 0;
    }

    .news-item {
      border-bottom: 1px solid rgba(255, 255, 255, 0.3);
      padding: 20px 0;
      display: flex;
      align-items: center;
      gap: 20px;
      transition: opacity 0.3s;
    }

    .news-item:hover {
      opacity: 0.7;
    }

    .news-date {
      font-size: 14px;
      letter-spacing: 2px;
      color: rgba(255, 255, 255, 0.8);
      white-space: nowrap;
    }

    .news-link {
      color: #fff;
      text-decoration: none;
      font-size: 16px;
      letter-spacing: 2px;
      flex: 1;
    }

    .news-more {
      text-align: center;
      margin-top: 30px;
    }

    .news-more-link {
      color: #fff;
      text-decoration: none;
      font-size: 14px;
      letter-spacing: 3px;
      padding-bottom: 5px;
      border-bottom: 1px solid #fff;
      transition: opacity 0.3s;
    }

    .news-more-link:hover {
      opacity: 0.7;
    }

    .page-2 {
      width: 100%;
      height: 100vh;
      background-color: transparent;
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 60px 40px;
    }

    .intro-text {
      width: 100%;
      max-width: 800px;
      color: #fff;
      margin-right: auto;
      margin-left: 20%;
    }

    .intro-text p {
      font-size: 16px;
      line-height: 2;
      letter-spacing: 1px;
      text-align: left;
      margin: 0;
    }

    .intro-text br {
      display: block;
      content: "";
      margin-top: 20px;
    }
  }
</style>
