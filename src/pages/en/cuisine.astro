---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Logo from '../../components/Logo.astro';
import ComingSoonPage from '../../components/pages/ComingSoonPage.astro';
import { getLangFromUrl, usePageContent } from '../../i18n/i18n';

const lang = getLangFromUrl(Astro.url);
const content = usePageContent(lang, 'comingSoon');
---

<BaseLayout>
  <Logo />
  <ComingSoonPage content={content} />
</BaseLayout>
