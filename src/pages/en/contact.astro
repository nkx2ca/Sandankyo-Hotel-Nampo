---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/i18n';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<BaseLayout>
  <main class="contact">
    <div class="container">
      <h1 class="page-title">Contact</h1>

      <div class="content">
        <section class="contact-section">
          <h2 class="section-title">Contact by Phone</h2>
          <div class="contact-info">
            <p class="hotel-name">Sandankyo Hotel Nampo</p>
            <p class="tel-number">
              <a href="tel:0826-28-2308">TEL: 0826-28-2308</a>
            </p>
            <p class="hours">Reception Hours: 9:00 AM - 6:00 PM</p>
          </div>
        </section>

        <section class="contact-section">
          <h2 class="section-title">Location</h2>
          <div class="contact-info">
            <p class="address">{t('address')}</p>
          </div>
        </section>

        <section class="contact-section">
          <h2 class="section-title">Contact by Email</h2>
          <div class="contact-info">
            <p class="email-note">
              For email inquiries, please include the following information.<br/>
              Our staff will contact you shortly.
            </p>
            <ul class="email-requirements">
              <li>Your name</li>
              <li>Contact information (phone number and email address)</li>
              <li>Inquiry details</li>
            </ul>
            <p class="email-address">
              <a href="mailto:info@sandankyo-nampo.com">info@sandankyo-nampo.com</a>
            </p>
            <p class="response-note">
              * Depending on the nature of your inquiry, it may take some time to respond.<br/>
              * Inquiries received on weekends and holidays will be answered on the next business day.
            </p>
          </div>
        </section>

        <section class="contact-section">
          <h2 class="section-title">Access</h2>
          <div class="contact-info">
            <p class="access-note">
              For detailed access information, please visit our <a href="/en/access" class="access-link">Access page</a>.
            </p>
          </div>
        </section>

        <section class="notice-section">
          <h3 class="notice-title">Reservations</h3>
          <p class="notice-text">
            Reservations can be made by phone or through our online reservation system.<br/>
            For online reservations, please click the "Book Now" button on the right side of the page.
          </p>
        </section>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .contact {
    min-height: 100vh;
    padding: 150px 20px 100px;
    background-color: #4e4c43;
  }

  .container {
    max-width: 1240px;
    height: auto;
    padding: 0 20px;
    margin: 0 auto;
  }

  .page-title {
    font-size: 32px;
    letter-spacing: 4px;
    text-align: center;
    margin-bottom: 60px;
    font-weight: normal;
    color: #fff;
  }

  .content {
    background-color: rgba(255, 255, 255, 0.05);
    padding: 40px;
    border-radius: 8px;
  }

  .contact-section {
    margin-bottom: 50px;
    padding-bottom: 40px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .contact-section:last-of-type {
    border-bottom: none;
    margin-bottom: 40px;
  }

  .section-title {
    font-size: 18px;
    font-weight: normal;
    letter-spacing: 2px;
    color: #fff;
    margin: 0 0 25px 0;
    padding-bottom: 10px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.2);
  }

  .contact-info {
    padding-left: 10px;
  }

  .hotel-name {
    font-size: 20px;
    letter-spacing: 2px;
    color: #fff;
    margin: 0 0 15px 0;
  }

  .tel-number {
    font-size: 24px;
    letter-spacing: 1px;
    margin: 0 0 15px 0;
  }

  .tel-number a {
    color: #fff;
    text-decoration: none;
    transition: opacity 0.3s;
  }

  .tel-number a:hover {
    opacity: 0.7;
  }

  .hours {
    font-size: 14px;
    letter-spacing: 1px;
    color: rgba(255, 255, 255, 0.8);
    margin: 0;
  }

  .address {
    font-size: 16px;
    line-height: 1.8;
    letter-spacing: 1px;
    color: #fff;
    margin: 0;
  }

  .email-note {
    font-size: 14px;
    line-height: 1.9;
    letter-spacing: 0.5px;
    color: #fff;
    margin: 0 0 20px 0;
  }

  .email-requirements {
    list-style: none;
    padding-left: 0;
    margin: 0 0 25px 0;
  }

  .email-requirements li {
    font-size: 14px;
    line-height: 1.8;
    letter-spacing: 0.5px;
    color: #fff;
    padding-left: 1.2em;
    position: relative;
    margin-bottom: 8px;
  }

  .email-requirements li::before {
    content: "・";
    position: absolute;
    left: 0;
  }

  .email-address {
    font-size: 18px;
    letter-spacing: 1px;
    margin: 0 0 20px 0;
  }

  .email-address a {
    color: #fff;
    text-decoration: underline;
    transition: opacity 0.3s;
  }

  .email-address a:hover {
    opacity: 0.7;
  }

  .response-note {
    font-size: 12px;
    line-height: 1.8;
    letter-spacing: 0.5px;
    color: rgba(255, 255, 255, 0.7);
    margin: 0;
  }

  .access-note {
    font-size: 14px;
    line-height: 1.9;
    letter-spacing: 0.5px;
    color: #fff;
    margin: 0;
  }

  .access-link {
    color: #fff;
    text-decoration: underline;
    transition: opacity 0.3s;
  }

  .access-link:hover {
    opacity: 0.7;
  }

  .notice-section {
    background-color: rgba(255, 255, 255, 0.08);
    padding: 30px;
    border-radius: 4px;
    border-left: 3px solid rgba(255, 255, 255, 0.3);
  }

  .notice-title {
    font-size: 16px;
    font-weight: normal;
    letter-spacing: 2px;
    color: #fff;
    margin: 0 0 15px 0;
  }

  .notice-text {
    font-size: 14px;
    line-height: 1.9;
    letter-spacing: 0.5px;
    color: #fff;
    margin: 0;
  }

  @media screen and (max-width: 960px) {
    .contact {
      padding: 120px 15px 80px;
    }

    .page-title {
      font-size: 24px;
      margin-bottom: 40px;
    }

    .content {
      padding: 25px 20px;
    }

    .contact-section {
      margin-bottom: 40px;
      padding-bottom: 30px;
    }

    .section-title {
      font-size: 16px;
      margin-bottom: 20px;
    }

    .hotel-name {
      font-size: 18px;
    }

    .tel-number {
      font-size: 20px;
    }

    .hours,
    .address,
    .email-note,
    .email-requirements li,
    .access-note,
    .notice-text {
      font-size: 13px;
    }

    .email-address {
      font-size: 16px;
    }

    .notice-section {
      padding: 20px;
    }

    .notice-title {
      font-size: 15px;
    }
  }
</style>

