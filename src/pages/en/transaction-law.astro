---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLangFromUrl } from '../../i18n/i18n';

const lang = getLangFromUrl(Astro.url);
---

<BaseLayout title="Statement Based on The Specified Commercial Transaction Law | Sandankyo Hotel Nampo" description="Statement Based on The Specified Commercial Transaction Law of Sandankyo Hotel Nampo">
  <main class="transaction-law">
    <div class="container">
      <h1 class="page-title">Statement Based on The Specified Commercial Transaction Law</h1>

      <div class="content">
        <table class="transaction-table">
          <tbody>
            <tr>
              <th>Business Operator</th>
              <td>Sandankyo-no-yado Co., Ltd.</td>
            </tr>
            <tr>
              <th>Representative</th>
              <td>President and CEO: Hideaki Kawamoto</td>
            </tr>
            <tr>
              <th>Site Name</th>
              <td>Sandankyo Hotel Nampo</td>
            </tr>
            <tr>
              <th>URL</th>
              <td><a href="https://sandankyo-nampo.com">https://sandankyo-nampo.com</a></td>
            </tr>
            <tr>
              <th>Address</th>
              <td>1734 Shibaki, Akiota-cho, Yamagata-gun, Hiroshima Prefecture, Japan</td>
            </tr>
            <tr>
              <th>Phone Number</th>
              <td>0826-28-2308</td>
            </tr>
            <tr>
              <th>Timing of Reservation Completion</th>
              <td>
                When making a hotel reservation using this website, the reservation is completed when the reservation completion notification is displayed on the screen.<br/>
                In the case of advance payment by credit card, the reservation is completed when the credit card payment is completed.
              </td>
            </tr>
            <tr>
              <th>Fees (Consideration for Services)</th>
              <td>
                Varies depending on the accommodation plan or product.<br/>
                Please refer to the accommodation plan details page for details.
              </td>
            </tr>
            <tr>
              <th>Payment Timing and Method</th>
              <td>
                Varies depending on the accommodation plan or product.<br/>
                Please refer to the accommodation plan details page for details.<br/>
                *In the case of advance payment by credit card, payment will be made by credit card when the online reservation is completed.
              </td>
            </tr>
            <tr>
              <th>Timing of Service Provision</th>
              <td>
                Varies depending on the accommodation plan or product.<br/>
                Please refer to the accommodation plan details page for details.
              </td>
            </tr>
            <tr>
              <th>Cancellation Fees</th>
              <td>
                Varies depending on the accommodation plan or product.<br/>
                Please refer to the accommodation plan details page for details.
              </td>
            </tr>
            <tr>
              <th>Refunds</th>
              <td>No refunds will be issued after use.</td>
            </tr>
            <tr>
              <th>Inquiries</th>
              <td>For inquiries regarding accommodation, please contact the hotel directly.</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .transaction-law {
    min-height: 100vh;
    padding: 150px 20px 100px;
    background-color: #4e4c43;
  }

  .container {
    max-width: 900px;
    margin: 0 auto;
  }

  .page-title {
    font-size: 24px;
    letter-spacing: 1px;
    text-align: center;
    margin-bottom: 60px;
    font-weight: normal;
    color: #fff;
    line-height: 1.6;
    word-wrap: break-word;
    max-width: 90%;
    margin-left: auto;
    margin-right: auto;
  }

  .content {
    background-color: rgba(255, 255, 255, 0.05);
    padding: 40px;
    border-radius: 8px;
  }

  .transaction-table {
    width: 100%;
    border-collapse: collapse;
  }

  .transaction-table th,
  .transaction-table td {
    padding: 20px;
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    color: #fff;
  }

  .transaction-table th {
    width: 240px;
    font-weight: normal;
    font-size: 14px;
    letter-spacing: 0.5px;
  }

  .transaction-table td {
    font-size: 14px;
    line-height: 1.8;
    letter-spacing: 0.5px;
  }

  .transaction-table tr:last-child th,
  .transaction-table tr:last-child td {
    border-bottom: none;
  }

  .transaction-table a {
    color: #fff;
    text-decoration: underline;
    transition: opacity 0.3s;
  }

  .transaction-table a:hover {
    opacity: 0.7;
  }

  @media screen and (max-width: 960px) {
    .transaction-law {
      padding: 120px 15px 80px;
    }

    .page-title {
      font-size: 18px;
      letter-spacing: 0.5px;
      margin-bottom: 40px;
      line-height: 1.5;
      max-width: 100%;
    }

    .content {
      padding: 20px;
    }

    .transaction-table th,
    .transaction-table td {
      display: block;
      width: 100%;
      padding: 10px 0;
    }

    .transaction-table th {
      padding-bottom: 5px;
      font-weight: bold;
    }

    .transaction-table td {
      padding-bottom: 20px;
    }
  }
</style>

