---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLangFromUrl } from '../../i18n/i18n';
import { newsItems } from '../../data/newsData';

const lang = getLangFromUrl(Astro.url);

export async function getStaticPaths({ paginate }) {
  return paginate(newsItems, { pageSize: 6 });
}

const { page } = Astro.props;
---

<BaseLayout>
  <main class="news">
    <div class="container">
      <h1 class="page-title">お知らせ</h1>

      <div class="content">
        <div class="news-list">
          {page.data.map((item) => (
            <a href={`/news/article/${item.id}`} class="news-item">
              <div class="news-header">
                <time class="news-date">{item.date}</time>
                <span class="news-category">{item.category}</span>
              </div>
              <h2 class="news-title">{item.title}</h2>
            </a>
          ))}
        </div>

        <nav class="pagination">
          {Array.from({ length: page.lastPage }, (_, i) => {
            const pageNum = i + 1;
            const href = pageNum === 1 ? '/news' : `/news/${pageNum}`;
            return (
              <a
                href={href}
                class:list={['page-btn', { active: page.currentPage === pageNum }]}
              >
                {pageNum}
              </a>
            );
          })}
        </nav>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .news {
    min-height: 100vh;
    padding: 150px 20px 100px;
    background-color: #4e4c43;
  }

  .container {
    max-width: 1240px;
    padding: 0 20px;
    margin: 0 auto;
  }

  .page-title {
    font-size: 32px;
    letter-spacing: 4px;
    text-align: center;
    margin-bottom: 60px;
    font-weight: normal;
    color: #fff;
  }

  .content {
    background-color: rgba(255, 255, 255, 0.05);
    padding: 40px;
    border-radius: 8px;
  }

  .news-list {
    display: flex;
    flex-direction: column;
    gap: 30px;
    margin-bottom: 50px;
  }

  .news-item {
    display: block;
    padding: 30px;
    background-color: rgba(255, 255, 255, 0.03);
    border-radius: 4px;
    border-left: 3px solid rgba(255, 255, 255, 0.2);
    transition: all 0.3s;
    cursor: pointer;
    text-decoration: none;
  }

  .news-item:hover {
    background-color: rgba(255, 255, 255, 0.08);
    border-left-color: rgba(255, 255, 255, 0.5);
    transform: translateX(5px);
  }

  .news-header {
    display: flex;
    align-items: center;
    gap: 15px;
    margin-bottom: 15px;
  }

  .news-date {
    font-size: 13px;
    letter-spacing: 1px;
    color: rgba(255, 255, 255, 0.7);
  }

  .news-category {
    display: inline-block;
    padding: 4px 12px;
    background-color: rgba(255, 255, 255, 0.15);
    border-radius: 3px;
    font-size: 11px;
    letter-spacing: 0.5px;
    color: #fff;
  }

  .news-title {
    font-size: 18px;
    font-weight: normal;
    letter-spacing: 1px;
    line-height: 1.6;
    color: #fff;
    margin: 0;
  }

  .pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 15px;
    padding-top: 40px;
    border-top: 1px solid rgba(255, 255, 255, 0.2);
  }

  .page-btn {
    width: 50px;
    height: 50px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2px solid #fff;
    background-color: transparent;
    color: #fff;
    font-size: 16px;
    font-weight: normal;
    letter-spacing: 1px;
    border-radius: 50%;
    text-decoration: none;
    transition: all 0.3s;
  }

  .page-btn:hover {
    background-color: rgba(255, 255, 255, 0.15);
    border-color: #fff;
    transform: scale(1.1);
  }

  .page-btn.active {
    background-color: #fff;
    border-color: #fff;
    color: #4e4c43;
    font-weight: bold;
  }

  .page-btn.active:hover {
    background-color: #fff;
    transform: scale(1.05);
  }

  @media screen and (max-width: 768px) {
    .news {
      padding: 120px 15px 80px;
    }

    .page-title {
      font-size: 24px;
      margin-bottom: 40px;
    }

    .content {
      padding: 25px 20px;
    }

    .news-list {
      gap: 20px;
      margin-bottom: 40px;
    }

    .news-item {
      padding: 20px;
    }

    .news-item:hover {
      transform: translateX(0);
    }

    .news-header {
      gap: 10px;
      margin-bottom: 12px;
    }

    .news-date {
      font-size: 12px;
    }

    .news-category {
      padding: 3px 10px;
      font-size: 10px;
    }

    .news-title {
      font-size: 16px;
      margin-bottom: 0;
    }

    .pagination {
      gap: 12px;
      padding-top: 30px;
    }

    .page-btn {
      width: 44px;
      height: 44px;
      font-size: 15px;
    }
  }
</style>
