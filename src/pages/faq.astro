---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLangFromUrl } from '../i18n/i18n';

const lang = getLangFromUrl(Astro.url);

const faqs = [
  {
    category: "ご予約について",
    items: [
      {
        question: "予約方法を教えてください。",
        answer: "お電話（TEL: 0826-28-2308）またはオンライン予約システムにて承っております。オンライン予約は当サイト右側の「宿泊予約」ボタンよりお進みください。"
      },
      {
        question: "予約のキャンセルはいつまで可能ですか？",
        answer: "キャンセルは可能ですが、キャンセル料が発生いたします。宿泊日の7日前から20%、3日前から50%、前日から80%、当日および不泊の場合は100%のキャンセル料を申し受けます。詳しくは宿泊約款をご確認ください。"
      },
      {
        question: "予約内容の変更はできますか？",
        answer: "ご予約内容の変更は、お電話にて承っております。空室状況により変更できない場合もございますので、お早めにご連絡ください。"
      }
    ]
  },
  {
    category: "チェックイン・チェックアウトについて",
    items: [
      {
        question: "チェックイン・チェックアウトの時間を教えてください。",
        answer: "チェックインは15:00から、チェックアウトは11:00までとなっております。"
      },
      {
        question: "チェックイン時刻より早く到着した場合、荷物を預かってもらえますか？",
        answer: "はい、チェックイン前でもフロントにてお荷物をお預かりいたします。"
      },
      {
        question: "レイトチェックアウトは可能ですか？",
        answer: "空室状況により、有料にて承っております。超過2時間までは室料金の50%、超過5時間までは室料金の100%を申し受けます。フロントまでお問い合わせください。"
      }
    ]
  },
  {
    category: "客室・設備について",
    items: [
      {
        question: "客室にアメニティはありますか？",
        answer: "バスタオル、フェイスタオル、歯ブラシ、シャンプー、コンディショナー、ボディソープなど基本的なアメニティをご用意しております。"
      },
      {
        question: "Wi-Fiは利用できますか？",
        answer: "はい、全客室および館内共用エリアにて無料Wi-Fiをご利用いただけます。"
      },
      {
        question: "禁煙ルームはありますか？",
        answer: "館内は全室禁煙となっております。喫煙は指定の喫煙所にてお願いいたします。"
      },
      {
        question: "バリアフリー対応の客室はありますか？",
        answer: "バリアフリー対応の客室をご用意しております。ご予約の際にお申し付けください。"
      }
    ]
  },
  {
    category: "お食事について",
    items: [
      {
        question: "食事付きプランはありますか？",
        answer: "はい、朝食付きプラン、夕朝食付きプランをご用意しております。季節の食材を使用した和食膳をお楽しみいただけます。"
      },
      {
        question: "アレルギー対応は可能ですか？",
        answer: "事前にお申し付けいただければ、可能な範囲で対応させていただきます。ご予約の際にお知らせください。"
      },
      {
        question: "レストランの営業時間を教えてください。",
        answer: "朝食は7:00〜9:00、夕食は18:00〜20:00（ラストオーダー19:30）となっております。"
      }
    ]
  },
  {
    category: "館内施設について",
    items: [
      {
        question: "温泉はありますか？",
        answer: "大浴場をご用意しております。営業時間など詳細は施設案内ページをご覧ください。"
      },
      {
        question: "駐車場はありますか？",
        answer: "はい、無料駐車場をご用意しております。台数に限りがございますので、満車の際はご了承ください。"
      },
      {
        question: "売店はありますか？",
        answer: "フロント付近に売店コーナーがございます。地域のお土産品などを取り扱っております。"
      }
    ]
  },
  {
    category: "お支払いについて",
    items: [
      {
        question: "支払い方法を教えてください。",
        answer: "現金、クレジットカード、旅行小切手でのお支払いが可能です。ご利用いただけるクレジットカードはVISA、MasterCard、JCB、AMEX、Dinersとなります。"
      },
      {
        question: "事前決済は可能ですか？",
        answer: "オンライン予約の場合、事前決済を選択いただけるプランもございます。"
      }
    ]
  },
  {
    category: "その他",
    items: [
      {
        question: "ペットの同伴は可能ですか？",
        answer: "申し訳ございませんが、盲導犬を除き、ペットの同伴はお断りしております。"
      },
      {
        question: "子供の宿泊料金はどうなりますか？",
        answer: "3歳以上12歳以下のお子様については、施設利用料として1泊3,300円（税込）を申し受けます。お子様用の食事及び寝具をご希望の場合は、別途料金が必要です。2歳以下の幼児で寝具・食事不要の場合は無料です。"
      },
      {
        question: "周辺の観光スポットを教えてください。",
        answer: "当館は特別名勝三段峡の玄関口に位置しております。三段峡の渓谷美をお楽しみいただけるほか、周辺には温井ダム、深入山などの観光スポットがございます。"
      },
      {
        question: "最寄り駅からの送迎はありますか？",
        answer: "申し訳ございませんが、定期的な送迎サービスは行っておりません。お車でのご来館をおすすめいたします。公共交通機関をご利用の場合は、アクセスページをご確認ください。"
      }
    ]
  }
];
---

<BaseLayout>
  <main class="faq">
    <div class="container">
      <h1 class="page-title">よくあるご質問</h1>

      <div class="content">
        <div class="intro">
          <p>お客様からよくいただくご質問をまとめました。</p>
          <p>こちらに掲載されていないご質問は、<a href="/contact" class="contact-link">お問い合わせページ</a>よりお気軽にお問い合わせください。</p>
        </div>

        {faqs.map((category) => (
          <section class="faq-category">
            <h2 class="category-title">{category.category}</h2>
            <div class="faq-list">
              {category.items.map((item, index) => (
                <details class="faq-item">
                  <summary class="faq-question">
                    <span class="question-icon">Q</span>
                    <span class="question-text">{item.question}</span>
                    <span class="toggle-icon"></span>
                  </summary>
                  <div class="faq-answer">
                    <span class="answer-icon">A</span>
                    <div class="answer-text">{item.answer}</div>
                  </div>
                </details>
              ))}
            </div>
          </section>
        ))}

        <div class="contact-notice">
          <h3 class="notice-title">その他のご質問</h3>
          <p class="notice-text">
            上記以外のご質問やご不明な点がございましたら、お気軽にお問い合わせください。<br/>
            TEL: <a href="tel:0826-28-2308" class="tel-link">0826-28-2308</a>（受付時間：9:00〜18:00）
          </p>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .faq {
    min-height: 100vh;
    padding: 150px 20px 100px;
    background-color: #4e4c43;
  }

  .container {
    max-width: 1000px;
    margin: 0 auto;
  }

  .page-title {
    font-size: 32px;
    letter-spacing: 4px;
    text-align: center;
    margin-bottom: 60px;
    font-weight: normal;
    color: #fff;
  }

  .content {
    background-color: rgba(255, 255, 255, 0.05);
    padding: 40px;
    border-radius: 8px;
  }

  .intro {
    margin-bottom: 50px;
    padding-bottom: 30px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.2);
    text-align: center;
  }

  .intro p {
    font-size: 14px;
    line-height: 1.9;
    letter-spacing: 0.5px;
    color: #fff;
    margin: 8px 0;
  }

  .contact-link {
    color: #fff;
    text-decoration: underline;
    transition: opacity 0.3s;
  }

  .contact-link:hover {
    opacity: 0.7;
  }

  .faq-category {
    margin-bottom: 50px;
  }

  .faq-category:last-of-type {
    margin-bottom: 40px;
  }

  .category-title {
    font-size: 20px;
    font-weight: normal;
    letter-spacing: 2px;
    color: #fff;
    margin: 0 0 25px 0;
    padding-bottom: 12px;
    border-bottom: 2px solid rgba(255, 255, 255, 0.3);
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 15px;
  }

  .faq-item {
    background-color: rgba(255, 255, 255, 0.03);
    border-radius: 4px;
    overflow: hidden;
    transition: background-color 0.3s;
  }

  .faq-item:hover {
    background-color: rgba(255, 255, 255, 0.05);
  }

  .faq-item[open] {
    background-color: rgba(255, 255, 255, 0.08);
  }

  .faq-question {
    display: flex;
    align-items: center;
    padding: 20px;
    cursor: pointer;
    list-style: none;
    position: relative;
    user-select: none;
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .question-icon {
    flex-shrink: 0;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background-color: rgba(255, 255, 255, 0.15);
    color: #fff;
    font-size: 14px;
    font-weight: bold;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-right: 15px;
  }

  .question-text {
    flex: 1;
    font-size: 15px;
    line-height: 1.7;
    letter-spacing: 0.5px;
    color: #fff;
    padding-right: 30px;
  }

  .toggle-icon {
    position: absolute;
    right: 20px;
    width: 12px;
    height: 12px;
    border-right: 2px solid rgba(255, 255, 255, 0.6);
    border-bottom: 2px solid rgba(255, 255, 255, 0.6);
    transform: rotate(45deg);
    transition: transform 0.3s;
  }

  .faq-item[open] .toggle-icon {
    transform: rotate(-135deg);
  }

  .faq-answer {
    display: flex;
    padding: 0 20px 25px 20px;
    animation: slideDown 0.3s ease;
  }

  @keyframes slideDown {
    from {
      opacity: 0;
      transform: translateY(-10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .answer-icon {
    flex-shrink: 0;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background-color: rgba(255, 255, 255, 0.2);
    color: #fff;
    font-size: 14px;
    font-weight: bold;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-right: 15px;
  }

  .answer-text {
    flex: 1;
    font-size: 14px;
    line-height: 1.9;
    letter-spacing: 0.5px;
    color: rgba(255, 255, 255, 0.95);
    padding-top: 4px;
  }

  .contact-notice {
    margin-top: 50px;
    padding: 30px;
    background-color: rgba(255, 255, 255, 0.08);
    border-radius: 4px;
    border-left: 3px solid rgba(255, 255, 255, 0.3);
  }

  .notice-title {
    font-size: 16px;
    font-weight: normal;
    letter-spacing: 2px;
    color: #fff;
    margin: 0 0 15px 0;
  }

  .notice-text {
    font-size: 14px;
    line-height: 1.9;
    letter-spacing: 0.5px;
    color: #fff;
    margin: 0;
  }

  .tel-link {
    color: #fff;
    text-decoration: underline;
    transition: opacity 0.3s;
  }

  .tel-link:hover {
    opacity: 0.7;
  }

  @media screen and (max-width: 960px) {
    .faq {
      padding: 120px 15px 80px;
    }

    .page-title {
      font-size: 24px;
      margin-bottom: 40px;
    }

    .content {
      padding: 25px 20px;
    }

    .intro {
      margin-bottom: 40px;
      padding-bottom: 25px;
    }

    .intro p {
      font-size: 13px;
    }

    .faq-category {
      margin-bottom: 40px;
    }

    .category-title {
      font-size: 18px;
      margin-bottom: 20px;
    }

    .faq-question {
      padding: 15px;
    }

    .question-icon,
    .answer-icon {
      width: 24px;
      height: 24px;
      font-size: 12px;
      margin-right: 12px;
    }

    .question-text {
      font-size: 14px;
      padding-right: 25px;
    }

    .toggle-icon {
      right: 15px;
      width: 10px;
      height: 10px;
    }

    .faq-answer {
      padding: 0 15px 20px 15px;
    }

    .answer-text {
      font-size: 13px;
      line-height: 1.8;
    }

    .contact-notice {
      padding: 20px;
    }

    .notice-title {
      font-size: 15px;
    }

    .notice-text {
      font-size: 13px;
    }
  }
</style>
