---
import BaseLayout from '../layouts/BaseLayout.astro';
import FaqPage from '../components/pages/FaqPage.astro';
import { getLangFromUrl, usePageContent } from '../i18n/i18n';

const lang = getLangFromUrl(Astro.url);
const content = usePageContent(lang, 'faq');
---

<BaseLayout>
  <FaqPage lang={lang} content={content} />
</BaseLayout>
