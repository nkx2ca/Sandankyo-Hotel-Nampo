---
import BaseLayout from '../layouts/BaseLayout.astro';
import FaqPage from '../components/pages/FaqPage.astro';
import { getLangFromUrl, usePageContent, usePageMeta } from '../i18n/i18n';

const lang = getLangFromUrl(Astro.url);
const content = usePageContent(lang, 'faq');
const meta = usePageMeta(lang, 'faq');
---

<BaseLayout title={meta.title} description={meta.description}>
  <FaqPage lang={lang} content={content} />
</BaseLayout>
