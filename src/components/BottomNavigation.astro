---
import { getRelativeLocaleUrl, getAbsoluteLocaleUrl } from 'astro:i18n';
import { getLangFromUrl, useTranslations, generateLocalePaths, generateLocaleUrls} from '../i18n/i18n';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const localePaths = generateLocalePaths(Astro.url);
---

<nav>
  <div class="nav_bar">
    <div class="nav_bar_column-1">
      <ul>
        <li>
          <button type="button">{t('nav_booking')}</button>
        </li>
      </ul>
    </div>
    <div class="nav_bar_column-2">
      <button type="button" class="hamburger">
        <span class="hamburger_lines hamburger_line-1"></span>
        <span class="hamburger_lines hamburger_line-2"></span>
        <span class="hamburger_lines hamburger_line-3"></span>
      </button>
    </div>
  </div>
  <div class="nav_menu">
    <div class="nav_menu_inner">
      <div class="logo">
        <div>Sandankyo Hotel</div>
        <div>Nampo</div>
      </div>
      <ul>
        <li><a href={getRelativeLocaleUrl(lang, '/')}>{t('menu_top')}</a></li>
        <li><a href={getRelativeLocaleUrl(lang, '/rooms')}>{t('menu_rooms')}</a></li>
        <li><a href={getRelativeLocaleUrl(lang, '/restaurants')}>{t('menu_restaurants')}</a></li>
        <li><a href={getRelativeLocaleUrl(lang, '/hot_springs')}>{t('menu_hot_springs')}</a></li>
        <li><a href={getRelativeLocaleUrl(lang, '/access')}>{t('menu_access')}</a></li>
        <li><a href={getRelativeLocaleUrl(lang, '/contact')}>{t('menu_contact')}</a></li>
      </ul>
      <div class="locale_button">
        <a href={getRelativeLocaleUrl(localePaths.ja.locale, '/')}>{localePaths.ja.label}</a>
        <div>/</div>
        <a href={getRelativeLocaleUrl(localePaths.en.locale, '/')}>{localePaths.en.label}</a>
      </div>
    </div>
  </div>
</nav>

<script>
  const hamburger = document.querySelector<HTMLElement>('.hamburger');
  const navMenu = document.querySelector<HTMLElement>('.nav_menu');
	const hamburgerLine1 = document.querySelector<HTMLElement>('.hamburger_line-1');
	const hamburgerLine2 = document.querySelector<HTMLElement>('.hamburger_line-2');
	const hamburgerLine3 = document.querySelector<HTMLElement>('.hamburger_line-3');
  hamburger?.addEventListener('click', () => {
    navMenu?.classList.toggle('active');
		hamburgerLine1?.classList.toggle('active');
		hamburgerLine2?.classList.toggle('active');
		hamburgerLine3?.classList.toggle('active');
	});
</script>

<style>
  nav {
    width: 100%;
    height: 100vh;
  }

  .nav_bar {
    width: 100%;
    height: 48px;
    display: flex;
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 200;
    align-items: center;
    justify-content: space-between;
    flex-direction: row;
  }
  
  .nav_bar_column-1 {
    flex-grow: 1;
    height: 100%;
  }
  
  .nav_bar_column-2 {
    width: 51px;
    height: 100%;
    border-left: 1px solid #4f4f4f;
  }
  
  .nav_bar_column-1 ul {
    width: 100%;
    height: 100%;
    display: flex;
    padding: 0;
    margin: 0;
    list-style: none;
  }
  
  .nav_bar_column-1 ul li {
    width: 100%;
    height: 100%;
  }
  
  .nav_bar_column-1 ul li button {
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    color:#fff;
    background-color: black;
    font-size: 100%;
    line-height: 1.15;
    margin: 0;
    font-family: "Times New Roman", "YuMincho", "Hiragino Mincho ProN", "Yu Mincho", "MS PMincho", serif;
  }
  
  .hamburger {
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    position: relative;
    background-color: black;
  }
  
  .hamburger_lines {
    display: block;
    width: 20px;
    height: 2px;
    border-radius: 2px;
    position: absolute;
    top: 23px;
    left: 0px;
    margin-left: 15px;
    margin-right: 15px;
    background-color: #fff;
  }
  
  .hamburger_line-1 {
    margin-top: -7px;
    transition: all 0.3s;
  }
  
  .hamburger_line-2 {
    transition: all 0.3s;
  }
  
  .hamburger_line-3 {
    margin-top: 7px;
    transition: all 0.3s;
  }

  .hamburger_line-1.active {
    transform: translateY(7px) rotate(-45deg);
  }

  .hamburger_line-2.active {
    opacity: 0;
  }

  .hamburger_line-3.active {
    transform: translateY(-7px) rotate(45deg);
  }

  .nav_menu {
    display: block;
    width: 100%;
    height: calc(100% - 48px);
    background-color: black;
    transition: all 0.3s;
    opacity: 0;
    bottom: -100vh;
    position: absolute;
  }

  .nav_menu.active {
    opacity: 1;
    bottom: 48px;
  }

  .nav_menu_inner {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: start;
    align-items: center;
    padding: 16px 20px 50px;
    border: 0;
    margin: 0;
  }

  .logo {
    background-color: black;
    color: #fff;
    width: 100%;
    height: 50px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }

  .logo > div {
  }

  .nav_menu ul {
    width: 100%;;
    display: flex;
    flex-direction: column;
    justify-content: start;
    align-items: center;
    padding: 0;
    border: 0;
    margin: 10px 0px 20px;
    list-style: none;
  }

  .nav_menu ul li {
    width: 100%;
    border-bottom: 1px solid #4f4f4f;
  }

  .nav_menu ul li a {
    display: block;
    width: 100%;
    height: 100%;
    padding: 20px 0;
    border: 0;
    color:#fff;
    background-color: black;
    font-size: 100%;
    line-height: 1.15;
    margin: 0;
    font-size: 19px;
    font-family: "Times New Roman", "YuMincho", "Hiragino Mincho ProN", "Yu Mincho", "MS PMincho", serif;
  }

  .locale_button {
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    width: 100%;
    height: 100px;
    background-color: black;
    color: #fff;
  }

  .locale_button a {
    margin: 0 20px;
    font-size: 16px;
    color: #fff;
  }

</style>