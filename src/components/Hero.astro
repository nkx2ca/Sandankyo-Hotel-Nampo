<div class="hero">
  <img src="/hero-sandankyo-gorge.jpeg"/>
  <div class="overlay">
    <div class="overlay_item-1">SANDANKYO HOTEL</div>
    <div>NAMPO</div>
  </div>
</div>

<style>
  .hero {
    width: 100vw;
    height: 100vh;
    position: relative;
    overflow: hidden;
  }

  img {
    width: 100%;
    position: absolute;
  }

  .overlay {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .overlay > div {
    z-index: 400;
    white-space: nowrap;
    font-size: 20px;
    letter-spacing: 8px;
    color: #fff;
    margin: 10px 0;
  }

  .overlay_item-1 {
    padding-bottom: 10px;
    border-bottom: 1px solid #fff;
  }
  

  
  @media screen and (min-width: 1025px) {
    .hero {
      width: 100vw;
      height: 100vh;
      position: relative;
      overflow: hidden;
    }
    
    .overlay {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      z-index: 300;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
    }

    .overlay > div {
      font-size: 40px;
      letter-spacing: 8px;
      color: #fff;
      margin: 10px 0;
    }

    .overlay_item-1 {
      padding-bottom: 10px;
      border-bottom: 1px solid #fff;
    }
  }
</style>
