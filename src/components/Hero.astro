---
---

<div class="hero">
  <video autoplay loop muted playsinline>
    <source src="/public/web_pc.mp4">
  </video>
  <div class="overlay">
    <div class="overlay_item-1">SANDANKYO HOTEL</div>
    <span></span>
    <div>NAMPO</div>
  </div>
</div>

<style>
  .hero {
    width: 100vw;
    height: calc(100vh - 47px);
    position: absolute;
    bottom: 47px;
    overflow: hidden;
  }
    
  video {
    min-width: 100%;
    min-height: 100%;
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
  }

  .overlay {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .overlay > div {
    z-index: 400;
    white-space: nowrap;
    font-size: 20px;
    letter-spacing: 8px;
    color: #fff;
    margin: 10px 0;
  }

  .overlay_item-1 {
    padding-bottom: 10px;
    border-bottom: 1px solid #fff;
  }

  
  @media screen and (min-width: 1025px) {
    .hero {
      width: 100vw;
      height: calc(100vh - 82px);
      position: absolute;
      top: 82px;
      overflow: hidden;
    }
    
    video {
      min-width: 100%;
      min-height: 100%;
      position: absolute;
      top: 0;
      left: 50%;
      transform: translate(-50%, 0);
    }

    .overlay {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      z-index: 300;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
    }

    .overlay > div {
      font-size: 40px;
      letter-spacing: 8px;
      color: #fff;
      margin: 10px 0;
    }

    .overlay_item-1 {
      padding-bottom: 10px;
      border-bottom: 1px solid #fff;
    }
  }
</style>