---
import { getRelativeLocaleUrl, getAbsoluteLocaleUrl } from 'astro:i18n';
import { getLangFromUrl, useTranslations, generateLocalePaths, generateLocaleUrls} from '../i18n/i18n';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const localePaths = generateLocalePaths(Astro.url);
const otherLang = lang === 'ja' ? localePaths.en.locale : localePaths.ja.locale;
---

<nav class="nav-bar">
  <button type="button" class="hamburger">
    <span class="hamburger-line hamburger-line-0"></span>
    <span class="hamburger-line hamburger-line-1"></span>
    <span class="hamburger-line hamburger-line-2"></span>
  </button>
  <a class="i18n" href={getRelativeLocaleUrl(otherLang, "/")}>{t('i18n')}</a>
  <a class="reservation" href="https://book.checkinn.jp/c14a2db858e37c71bd5f7c18fa481f2abc7ba72aec347019170c970dd727246b" target="_blank">{t('reservation')}</a>
</nav>

<div class="nav-overlay"></div>

<div class="nav-opened">
  <div class="container">
    <div class="main">
      <a class="main-item" href={getRelativeLocaleUrl(lang, "rooms")}>{t('rooms')}</a>
      <a class="main-item" href={getRelativeLocaleUrl(lang, "cuisine")}>{t('cuisine')}</a>
      <a class="main-item" href={getRelativeLocaleUrl(lang, "facility")}>{t('facility')}</a>
      <a class="main-item" href={getRelativeLocaleUrl(lang, "gallery")}>{t('gallery')}</a>
    </div>
    <div class="sub">
      <a class="sub-item" href={getRelativeLocaleUrl(lang, "access")}>{t('access')}</a>
      <a class="sub-item" href={getRelativeLocaleUrl(lang, "news")}>{t('news')}</a>
      <a class="sub-item" href={getRelativeLocaleUrl(lang, "faq")}>{t('faq')}</a>
      <a class="sub-item" href={getRelativeLocaleUrl(lang, "contact")}>{t('contact')}</a>
    </div>
    <div class="sns">
      <a class="instagram-icon" href="https://www.instagram.com/sandankyohotelnampo/" target="_blank" rel="noopener noreferrer">
        <img src=`${import.meta.env.BASE_URL}instagram_logo_white.png`/>
      </a>
      <a class="facebook-icon" href="https://www.facebook.com/profile.php?id=61583321145882" target="_blank" rel="noopener noreferrer">
        <img src=`${import.meta.env.BASE_URL}facebook_logo_white.png`/>
      </a>
      <div class="copyright">@2026 NAMPO</div>
    <div>
  </div>
</div>

<script>
  const hamburger = document.querySelector<HTMLElement>('.hamburger');
  const navMenu = document.querySelector<HTMLElement>('.nav-opened');
  const navOverlay = document.querySelector<HTMLElement>('.nav-overlay');
  const navBar = document.querySelector<HTMLElement>('.nav-bar');
  const hamburgerLine0 = document.querySelector<HTMLElement>('.hamburger-line-0');
  const hamburgerLine1 = document.querySelector<HTMLElement>('.hamburger-line-1');
  const hamburgerLine2 = document.querySelector<HTMLElement>('.hamburger-line-2');

  hamburger?.addEventListener('click', () => {
    navMenu?.classList.toggle('active');
    navOverlay?.classList.toggle('active');
    hamburgerLine0?.classList.toggle('active');
    hamburgerLine1?.classList.toggle('active');
    hamburgerLine2?.classList.toggle('active');
  });

  navOverlay?.addEventListener('click', () => {
    navMenu?.classList.remove('active');
    navOverlay?.classList.remove('active');
    hamburgerLine0?.classList.remove('active');
    hamburgerLine1?.classList.remove('active');
    hamburgerLine2?.classList.remove('active');
  });

  // スクロール時の背景変更（モバイルのみ）
  function handleScroll() {
    if (window.innerWidth <= 960) {
      if (window.scrollY > 50) {
        navBar?.classList.add('scrolled');
      } else {
        navBar?.classList.remove('scrolled');
      }
    }
  }

  window.addEventListener('scroll', handleScroll);
  window.addEventListener('resize', handleScroll);
  handleScroll(); // 初期状態をチェック
</script>


<style>
 .nav-bar {
   width: 90px;
   height: 100vh;
   background-color: transparent;
   opacity: 1;
   position: fixed;
   top: 0;
   bottom: 0;
   right: 0;
   z-index: 111;
   display: flex;
   flex-direction: column;
   justify-content: flex-start;
   align-items: center;
 }

 .hamburger {
   width: 100%;
   height: 80px;
   padding: 0;
   border: 0;
   background-color: transparent;
   position: relative;
   display: flex;
   justify-content: center;
   align-items: center;
 }

 .hamburger-line {
   width: 40px;
   height: 2px;
   border-radius: 2px;
   margin-left: 0px;
   margin-right: 0px;
   background-color: #fff;
   position: absolute;
   display: flex;
   justify-content: center;
   align-items: center;
  }

  .hamburger-line-0 {
    margin-top: -20px;
    transition: all 0.3s;
  }
  
  .hamburger-line-1 {
    transition: all 0.3s;
  }
  
  .hamburger-line-2 {
    margin-top: 20px;
    transition: all 0.3s;
  }

  .hamburger-line-0.active {
    transform: translateY(10px) rotate(-765deg);
  }

  .hamburger-line-1.active {
    opacity: 0;
  }

  .hamburger-line-2.active {
    transform: translateY(-10px) rotate(-495deg);
  }

 .i18n {
   width: 40px;
   height: 40px;
   color: #fff;
   font-size: 13px;
   border-radius: 50%;
   text-align: center;
   line-height: 40px;
   border: solid 1px #fff;
 }

 .reservation {
   font-family: "游明朝体", "YuMincho", "游明朝", "Yu Mincho", "ヒラギノ明朝 ProN W3", "Hiragino Mincho ProN W3", HiraMinProN-W3, "ヒラギノ明朝 ProN", "Hiragino Mincho ProN", "ヒラギノ明朝 Pro", "Hiragino Mincho Pro", "HGS明朝E", "ＭＳ Ｐ明朝", "MS PMincho", serif;
   width: 100%;
   height: auto;
   background-color: transparent;
   margin: 25px 0;
   font-size: 16px;
   color: #fff;
   writing-mode: vertical-rl;
   letter-spacing: 0.3em;
   white-space: nowrap;
   text-overflow: elipsis;
   display: flex;
   justify-content: center;
   align-items: center;
   padding: 0px 0px;
 }

 .nav-overlay {
   position: fixed;
   top: 0;
   left: 0;
   width: 100%;
   height: 100%;
   background-color: rgba(0, 0, 0, 0.6);
   z-index: 100;
   opacity: 0;
   visibility: hidden;
   transition: opacity 0.5s, visibility 0.5s;
 }

 .nav-overlay.active {
   opacity: 1;
   visibility: visible;
 }

 .nav-opened {
   width: 400px;
   height: 100%;
   background-color: #000;
   right: -400px;
   overflow: hidden;
   opacity: 0;
   position: fixed;
   z-index: 110;
   transition: all 1s;
 }

 .nav-opened.active {
   opacity: 1;
   top: 0px;
   right: 0px;
 }

 .container {
   width: 100%;
   height: 100%;
   padding: 20px 20px 20px 30px;
   display: flex;
   flex-direction: column;
   flex-wrap: nowrap;
   justify-content: flex-start;
   align-items: flex-start;
 }

 .main {
   width: 100%;
   padding: 90px 0px 20px 0px;
   color: #fff;
   display: flex;
   flex-direction: column;
 }

 .main-item {
   margin: 0px 0px 15px 0px;
   font-size: 22px;
 }

 .sub {
   width: 100%;
   padding: 20px 0px 0px 0px;
   color: #fff;
   display: flex;
   flex-direction: column;
 }

 .sub-item {
   margin: 0px 0px 15px 0px;
   font-size: 16px;
 }

 .sns {
   width: 100%;
   height: 20px;
   margin-top: auto;
   margin-bottom: 0;
   color: #fff;
   display: flex;
   flex-direction: row;
   justify-content: flex-start;
 }

 .instagram-icon {
   height: 100%;
   display: flex;
 }

 .facebook-icon {
   height: 100%;
   display: flex;
   margin-left: 15px;
 }
 
 .copyright {
   margin-left: auto;
   font-size: 10px;
   align-self: flex-end;
 }


 @media screen and (max-width: 960px) {
   .nav-bar {
     width: 100%;
     height: 60px;
     flex-direction: row;
     justify-content: flex-end;
     align-items: center;
     gap: 15px;
     padding: 0 15px;
     top: 0;
     left: 0;
     right: auto;
     bottom: auto;
     background-color: transparent;
     backdrop-filter: none;
     transition: background-color 0.3s ease, backdrop-filter 0.3s ease;
   }

   .nav-bar.scrolled {
     background-color: rgba(0, 0, 0, 0.3);
     backdrop-filter: blur(10px);
   }

   .hamburger {
     height: 60px;
     width: auto;
     order: 3;
     margin-left: 20px;
     margin-right: 10px;
   }

   .hamburger-line {
     width: 30px;
   }

   .hamburger-line-0 {
     margin-top: -15px;
   }

   .hamburger-line-2 {
     margin-top: 15px;
   }

   .hamburger-line-0.active {
     transform: translateY(7.5px) rotate(-765deg);
   }

   .hamburger-line-2.active {
     transform: translateY(-7.5px) rotate(-495deg);
   }

   .i18n {
     width: 30px;
     height: 30px;
     font-size: 10px;
     line-height: 30px;
     order: 2;
     margin-left: 5px;
   }

   .reservation {
     font-size: 12px;
     letter-spacing: 0.1em;
     margin: 0;
     writing-mode: horizontal-tb;
     padding: 0;
     order: 1;
     white-space: nowrap;
     width: auto;
   }

   .nav-opened {
     width: 80vw;
     max-width: 320px;
     right: -80vw;
   }

   .nav-opened.active {
     right: 0;
   }

   .container {
     padding: 15px 15px 15px 20px;
   }

   .main {
     padding: 80px 0 15px 0;
   }

   .main-item {
     font-size: 20px;
     margin-bottom: 12px;
   }

   .sub {
     padding: 15px 0 0 0;
   }

   .sub-item {
     font-size: 14px;
     margin-bottom: 12px;
   }

   .sns {
     height: 18px;
   }

   .instagram-icon img,
   .facebook-icon img {
     height: 100%;
     width: auto;
   }

   .facebook-icon {
     margin-left: 12px;
   }

   .copyright {
     font-size: 9px;
   }
 }
</style>
