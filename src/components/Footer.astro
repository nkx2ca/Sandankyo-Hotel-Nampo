---
import { getRelativeLocaleUrl, getAbsoluteLocaleUrl } from 'astro:i18n';
import { getLangFromUrl, useTranslations, generateLocalePaths, generateLocaleUrls} from '../i18n/i18n';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const localePaths = generateLocalePaths(Astro.url);
---

<footer>
  <div class="main-container">
    <div class="left-container">
      <img class="footer-logo" src=`${import.meta.env.BASE_URL}logo_with_text_white.png` alt="Sandankyo Hotel Nampo" />
      <div class="footer-sns">
        <img class="footer-instagram" src=`${import.meta.env.BASE_URL}instagram_logo_white.png`/>
        <img class="footer-facebook" src=`${import.meta.env.BASE_URL}facebook_logo_white.png`/>
      </div>
    </div>
    <div class="right-container">
      <div class="address-container">
        <p class="tel">TEL: 0826-28-2308</p>
        <p class="address">{t('address')}</p>
      </div>
      <div class="company-container">
        <p class="hotel-name">{t('hotel-name')}</p>
        <p class="restaurant-name">{t('restaurant-name')}</p>
      </div>
      <div class="others-container">
        <a href={getRelativeLocaleUrl(lang, "privacy-policy")}><p class="privacy-policy">{t('privacy-policy')}</p></a>
        <a href={getRelativeLocaleUrl(lang, "transaction-law")}><p class="transaction-law">{t('transaction-law')}</p></a>
        <a href={getRelativeLocaleUrl(lang, "accommodation-terms")}><p class="accommodation-terms">{t('accommodation-terms')}</p></a>
      </div>
    </div>
  </div>
</footer>

<style>
  @media screen and (max-width: 960px) {
  }

  footer {
    width: 100%;
    height: 400px;
    background-color: #001914;
    padding-top: 100px;
    padding-bottom: 40px;
    color: #fff;
  }
  
  .main-container {
    max-width: 1240px;
    height: 100%;
    padding: 0 20px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }
  
  .left-container {
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: flex-start;
  }
  
  .footer-logo {
    width: 120px;
    height: auto;
  }
  
  .footer-sns {
    width: 120px;
    height: auto;
  }
  
  .footer-instagram {
    width: 30px;
    height: auto;
    margin-right: 15px;
  }
  
  .footer-facebook {
    width: 30px;
    height: auto;
  }
  
  .right-container {
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: flex-end;
    text-align: right;
  }
  
  .address-container {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    margin-bottom: 30px;
    gap: 7px;
  }
  
  .tel {
    font-size: 16px;
    letter-spacing: 0.5px;
    margin: 0;
  }

  .address {
    font-size: 16px;
    letter-spacing: 0.5px;
    margin: 0;
  }

  .company-container {
    display: flex;
    flex-direction: column;
    gap: 7px;
  }
  
  .hotel-name {
    font-size: 16px;
    letter-spacing: 0.5px;
    margin: 0;
  }
  
  .restaurant-name {
    font-size: 16px;
    letter-spacing: 0.5px;
    margin: 0;
  }
  
  .others-container {
    display: flex;
    flex-direction: column;
    margin-top: auto;
    gap: 5px;
  }
  
  .privacy-policy {
    font-size: 12px;
    letter-spacing: 0.5px;
    margin: 0;
  }

  .transaction-law {
    font-size: 12px;
    letter-spacing: 0.5px;
    margin: 0;
  }
 
  .accommodation-terms {
    font-size: 12px;
    letter-spacing: 0.5px;
    margin: 0;
  }
</style>
