---
import { getRelativeLocaleUrl, getAbsoluteLocaleUrl } from 'astro:i18n';
import { getLangFromUrl, useTranslations, generateLocalePaths, generateLocaleUrls} from '../i18n/i18n';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const localePaths = generateLocalePaths(Astro.url);
---

<footer>
  <div class="main-container">
    <div class="left-container">
      <img class="footer-logo" src=`${import.meta.env.BASE_URL}logo_with_text_white.png` alt="Sandankyo Hotel Nampo" />
      <div class="footer-sns">
        <img class="footer-instagram" src=`${import.meta.env.BASE_URL}instagram_logo_white.png`/>
        <img class="footer-facebook" src=`${import.meta.env.BASE_URL}facebook_logo_white.png`/>
      </div>
    </div>
    <div class="right-container">
      <div class="address-container">
        <p class="tel">TEL: 0826-28-2308</p>
        <p class="address">{t('address')}</p>
      </div>
      <div class="company-container">
        <p class="hotel-name">{t('hotel-name')}</p>
        <p class="restaurant-name">{t('restaurant-name')}</p>
      </div>
      <div class="others-container">
        <a href={getRelativeLocaleUrl(lang, "privacy-policy")}><p class="privacy-policy">{t('privacy-policy')}</p></a>
        <a href={getRelativeLocaleUrl(lang, "transaction-law")}><p class="transaction-law">{t('transaction-law')}</p></a>
        <a href={getRelativeLocaleUrl(lang, "accommodation-terms")}><p class="accommodation-terms">{t('accommodation-terms')}</p></a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer {
    width: 100%;
    height: 400px;
    background-image: linear-gradient(to bottom,rgba(0, 0, 0, 0.4) 0%,rgba(0, 0, 0, 0.7) 100%),url('/footer.jpg');
    background-size: cover;
    padding-top: 100px;
    padding-bottom: 40px;
    color: #fff;
  }

  .main-container {
    max-width: 1240px;
    height: 100%;
    padding: 0 20px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }

  .left-container {
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: flex-start;
  }

  .footer-logo {
    width: 120px;
    height: auto;
  }

  .footer-sns {
    width: 120px;
    height: auto;
  }

  .footer-instagram {
    width: 30px;
    height: auto;
    margin-right: 15px;
  }

  .footer-facebook {
    width: 30px;
    height: auto;
  }

  .right-container {
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: flex-end;
    text-align: right;
  }

  .address-container {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    margin-bottom: 30px;
    gap: 7px;
  }

  .tel {
    font-size: 16px;
    letter-spacing: 0.5px;
    margin: 0;
  }

  .address {
    font-size: 16px;
    letter-spacing: 0.5px;
    margin: 0;
  }

  .company-container {
    display: flex;
    flex-direction: column;
    gap: 7px;
  }

  .hotel-name {
    font-size: 16px;
    letter-spacing: 0.5px;
    margin: 0;
  }

  .restaurant-name {
    font-size: 16px;
    letter-spacing: 0.5px;
    margin: 0;
  }

  .others-container {
    display: flex;
    flex-direction: column;
    margin-top: auto;
    gap: 5px;
  }

  .privacy-policy {
    font-size: 12px;
    letter-spacing: 0.5px;
    margin: 0;
  }

  .transaction-law {
    font-size: 12px;
    letter-spacing: 0.5px;
    margin: 0;
  }

  .accommodation-terms {
    font-size: 12px;
    letter-spacing: 0.5px;
    margin: 0;
  }

  /* モバイル対応 */
  @media screen and (max-width: 960px) {
    footer {
      height: auto;
      padding: 60px 0 40px;
      background-position: center;
    }

    .main-container {
      padding: 0 15px;
      flex-direction: column;
      gap: 40px;
    }

    .left-container {
      width: 100%;
      height: auto;
      gap: 20px;
    }

    .footer-logo {
      width: 100px;
    }

    .footer-sns {
      width: auto;
      display: flex;
      gap: 15px;
    }

    .footer-instagram {
      width: 28px;
      margin-right: 0;
    }

    .footer-facebook {
      width: 28px;
    }

    .right-container {
      width: 100%;
      height: auto;
      align-items: flex-start;
      text-align: left;
      gap: 25px;
    }

    .address-container {
      margin-bottom: 0;
      gap: 5px;
    }

    .tel {
      font-size: 14px;
    }

    .address {
      font-size: 14px;
      line-height: 1.6;
    }

    .company-container {
      gap: 5px;
    }

    .hotel-name {
      font-size: 14px;
    }

    .restaurant-name {
      font-size: 14px;
    }

    .others-container {
      margin-top: 0;
      gap: 8px;
    }

    .privacy-policy {
      font-size: 11px;
    }

    .transaction-law {
      font-size: 11px;
    }

    .accommodation-terms {
      font-size: 11px;
    }
  }
</style>
