---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { getLangFromUrl, useTranslations } from '../i18n/i18n';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<footer>
  <div class="footer-content">
    <div class="footer-left">
      <img class="footer-logo" src=`${import.meta.env.BASE_URL}logo_with_text_white.png` alt="Sandankyo Hotel Nampo" />
    </div>
    <div class="footer-right">
      <p class="footer-address">〒731-3813</p>
      <p class="footer-address">{lang === 'ja' ? '広島県山県郡安芸太田町柴木1734-1' : '1734-1 Shibaki, Akiota-cho, Yamagata-gun, Hiroshima 731-3813'}</p>
      <p class="footer-tel">TEL: 0826-28-2255</p>
    </div>
  </div>
</footer>

<style>
  @media screen and (min-width: 1025px) {
    footer {
      width: 100%;
      height: 300px;
      background-color: rgb(78, 76, 67);
      padding: 80px 40px 40px;
      color: #fff;
    }

    .footer-content {
      max-width: 1200px;
      margin: 0 auto;
      height: 100%;
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
    }

    .footer-left {
      display: flex;
      align-items: flex-start;
    }

    .footer-logo {
      width: 80px;
      height: auto;
    }

    .footer-right {
      text-align: right;
    }

    .footer-address {
      font-size: 14px;
      letter-spacing: 0.5px;
      margin: 5px 0;
    }

    .footer-tel {
      font-size: 14px;
      letter-spacing: 0.5px;
      margin-top: 15px;
    }
  }
</style>
